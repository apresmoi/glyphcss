{
  // Keep the file watcher off generated/scratch trees. `.claude/worktrees` alone holds
  // ~480k files and churns tens of thousands per day, which overflows FSEvents and
  // drives the VS Code main process toward its heap limit.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.claude/**": true,
    "**/.pnpm-store/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/etopo/**": true,
    "**/gadm_410.gdb/**": true,
    "**/research/**": true,
    "**/.local/**": true,
    "**/website/.baseline-shots/**": true,
    "**/bench/static-effect-export/out/**": true,
    "**/bench/static-effect-export/shots/**": true,
    "**/*.pmtiles": true
  },
  "search.exclude": {
    "**/.claude/**": true,
    "**/.pnpm-store/**": true,
    "**/etopo/**": true,
    "**/research/**": true
  }
}
