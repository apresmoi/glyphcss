{
  "name": "@glyphcss/diagrams",
  "version": "0.3.1",
  "description": "Render Mermaid and JSON as ASCII and box-drawing diagrams for chat, terminals and web apps: flowcharts, sequences, states, ER and Git graphs.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "glyphcss",
    "ascii",
    "diagrams",
    "mermaid",
    "terminal",
    "cli",
    "flowchart",
    "sequence-diagram",
    "state-diagram",
    "er-diagram",
    "gitgraph",
    "ascii-diagram",
    "text-diagram",
    "box-drawing",
    "mermaid-ascii",
    "llm",
    "agent",
    "claude-code",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apresmoi/glyphcss.git",
    "directory": "packages/diagrams"
  },
  "bugs": {
    "url": "https://github.com/apresmoi/glyphcss/issues"
  },
  "homepage": "https://glyphcss.com/diagrams/",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./elk": {
      "types": "./dist/elk.d.ts",
      "import": "./dist/elk.js",
      "require": "./dist/elk.cjs"
    },
    "./sequence": {
      "types": "./dist/sequence.d.ts",
      "import": "./dist/sequence.js",
      "require": "./dist/sequence.cjs"
    },
    "./lanes": {
      "types": "./dist/lanes.d.ts",
      "import": "./dist/lanes.js",
      "require": "./dist/lanes.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "elk": [
        "dist/elk.d.ts"
      ],
      "sequence": [
        "dist/sequence.d.ts"
      ],
      "lanes": [
        "dist/lanes.d.ts"
      ]
    }
  },
  "scripts": {
    "bench": "node --experimental-strip-types bench/run.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run typecheck && vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "glyphcss": "workspace:^",
    "@glyphcss/core": "workspace:^"
  },
  "peerDependencies": {
    "elkjs": "^0.11.0"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.1.1",
    "ajv": "^8.20.0",
    "happy-dom": "^20.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  }
}
