{
  "name": "@glyphcss/effects",
  "version": "0.1.6",
  "description": "Reusable spatial glyph effects for glyphcss scenes.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "glyphcss",
    "ascii",
    "effects",
    "animation",
    "texture",
    "matrix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apresmoi/glyphcss.git",
    "directory": "packages/effects"
  },
  "bugs": {
    "url": "https://github.com/apresmoi/glyphcss/issues"
  },
  "homepage": "https://github.com/apresmoi/glyphcss#readme",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "glyphcss": "workspace:^"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@vitest/coverage-v8": "^3.1.1",
    "happy-dom": "^20.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  }
}
