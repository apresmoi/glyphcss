---
import ChartsWorkbench from '../components/ChartsWorkbench/ChartsWorkbench.tsx';
import DocsHeader from '../components/DocsHeader.astro';
import BaseHead from '../components/BaseHead.astro';

const title = 'Charts — ASCII data viz | glyphcss';
const description = 'A declarative, Observable-Plot-flavoured chart spec rendered as ASCII/box/braille output for chat, terminal and web, built on glyphcss.';
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path="/charts/" />
  </head>
  <body>
    <div class="page">
      <DocsHeader />
      <div class="debug-page-shell">
        <ChartsWorkbench client:only="react" />
      </div>
    </div>
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    @media (max-width: 38rem) {
      :global(:root) { --sl-nav-height: 90px; }
    }
    :global(html, body) {
      margin: 0;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
    :global(body) { min-height: 100vh; }
    .debug-page-shell {
      position: fixed;
      inset-block-start: var(--sl-nav-height);
      inset-inline: 0;
      inset-block-end: 0;
    }
  </style>
</html>
