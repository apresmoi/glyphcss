---
import GlyphDiagramsWorkbench from '../components/DiagramsWorkbench/DiagramsWorkbench.tsx';
import DocsHeader from '../components/DocsHeader.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/glyph-demo.css';

const title = 'Diagrams — ASCII graphs | glyphcss';
const description = 'Render Mermaid flowcharts, LangGraph agents and JSON graphs as ASCII, box-drawing, block and braille diagrams for chat, terminal and web.';
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path="/diagrams/" />
  </head>
  <body>
    <div class="page">
      <DocsHeader />
      <div class="debug-page-shell">
        <GlyphDiagramsWorkbench client:only="react" />
      </div>
    </div>
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    @media (max-width: 38rem) { :global(:root) { --sl-nav-height: 90px; } }
    :global(html, body) {
      margin: 0;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
    :global(body) { min-height: 100vh; overflow: hidden; }
  </style>
</html>
