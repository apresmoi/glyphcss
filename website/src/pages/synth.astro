---
import SynthWorkbench from '../components/SynthWorkbench/SynthWorkbench.tsx';
import DocsHeader from '../components/DocsHeader.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/glyph-demo.css';

const title = 'Synth — modular ASCII field synthesizer | glyphcss';
const description = 'Stack oscillators into moiré interference and map them to glyphs — a live, in-browser modular synthesizer for animated ASCII fields, built on glyphcss.';
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path="/synth/" image="/og/synth.png" />
  </head>
  <body>
    <div class="page">
      <DocsHeader />
      <div class="debug-page-shell">
        <SynthWorkbench client:only="react" />
      </div>
    </div>
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    @media (max-width: 38rem) {
      :global(:root) { --sl-nav-height: 90px; }
    }
    :global(html, body) {
      margin: 0;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
    :global(body) { min-height: 100vh; overflow: hidden; }
  </style>
</html>
