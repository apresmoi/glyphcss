---
import SynthWorkbench from '../components/SynthWorkbench/SynthWorkbench.tsx';
import DocsHeader from '../components/DocsHeader.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/glyph-demo.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Synth — glyphcss</title>
  </head>
  <body>
    <div class="page">
      <DocsHeader />
      <div class="debug-page-shell">
        <SynthWorkbench client:only="react" />
      </div>
    </div>
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    @media (max-width: 38rem) {
      :global(:root) { --sl-nav-height: 90px; }
    }
    :global(html, body) {
      margin: 0;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
    :global(body) { min-height: 100vh; overflow: hidden; }
  </style>
</html>
