---
import ExamplesSidebar from "../../components/ExamplesSidebar.astro";
import DocsHeader from "../../components/DocsHeader.astro";
import BaseHead from "../../components/BaseHead.astro";
const title = "glyphcss · Image → Glyph";
const description = "Drop or paste any image and watch it rasterise into shaded, colored ASCII — flat, or escalated into stepped 3D relief along luminance and color boundaries, with glyph effects running on the surface.";
---

<html lang="en">
<head>
  <BaseHead title={title} description={description} path="/examples/image/" image="/og/image.png" />
  <style>
    html, body { background: #04060b; color: #e2e8f0; margin: 0; min-height: 100vh; font-family: ui-monospace, "JetBrains Mono", "SF Mono", monospace; }
    body { display: flex; overflow: hidden; }
    /* Sit the examples shell below the fixed site header so the top nav stays
       reachable (Home / Gallery / WordArt / …). */
    .ex-layout { position: fixed; inset: var(--sl-nav-height, 72px) 0 0; display: flex; min-width: 0; }
    .ex-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .map-head { padding: 20px 28px 10px; border-bottom: 1px solid rgba(255,232,184,0.12); }
    .map-head h1 { margin: 0; font-size: 20px; color: rgba(255,232,184,0.94); letter-spacing: 0.04em; }
    .map-head p { margin: 6px 0 0; font-size: 12px; color: rgba(255,232,184,0.5); }
    .map-stage { flex: 1; min-height: 0; position: relative; overflow: hidden; }

    /* The glyphcss scene host fills the stage; the renderer's <pre> sits inside. */
    .img-host { position: absolute; inset: 0; font-size: 8.125px; }
    .img-host .glyph-scene { width: 100%; height: 100%; }
    .img-host .glyph-output { color: rgba(255,232,184,0.96); margin: 0; }

    .drop-hint {
      position: absolute; inset: 24px; border: 1px dashed rgba(255,232,184,0.25);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      color: rgba(255,232,184,0.5); font-size: 14px; text-align: center; pointer-events: none;
    }
    .drop-hint b { color: rgba(56,189,248,0.9); font-weight: 600; }
    .drop-hint span { font-size: 11px; color: rgba(255,232,184,0.35); }
    .map-stage.dragover { background: rgba(56,189,248,0.06); }
    .map-stage.dragover .drop-hint { border-color: rgba(56,189,248,0.7); color: rgba(56,189,248,0.9); }

    .iso-controls {
      position: absolute; top: 14px; right: 14px; z-index: 10;
      width: 230px; padding: 12px 14px; max-height: calc(100% - 28px); overflow-y: auto;
      background: rgba(8,12,18,0.9); backdrop-filter: blur(4px);
      border: 1px solid rgba(255,232,184,0.18);
      font-size: 11px; color: rgba(255,232,184,0.7);
    }
    .iso-controls h2 { margin: 0 0 10px; font-size: 11px; letter-spacing: 0.08em; color: rgba(56,189,248,0.9); font-weight: 600; }
    /* Desktop: the toggle button is mobile-only chrome. */
    .iso-ctl-toggle { display: none; }
    /* Mobile: collapse the controls into a bottom drawer (collapsed by default),
       opened via a [ Controls ] button — mirrors the gallery's mobile panels. */
    @media (max-width: 50rem) {
      .iso-ctl-toggle {
        display: block;
        position: absolute; left: 0; right: 0; bottom: 0; z-index: 31;
        min-height: 44px; padding: 0 12px;
        background: rgba(8,12,18,0.94); color: rgba(255,232,184,0.9);
        border: none; border-top: 1px solid rgba(255,232,184,0.18);
        font: 600 13px/1 ui-monospace, "JetBrains Mono", monospace;
        letter-spacing: 0.04em; cursor: pointer;
        backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      }
      .iso-controls {
        top: auto; right: 0; left: 0; bottom: 44px; z-index: 30;
        width: auto; max-height: 55vh; overflow-y: auto;
        border: none; border-top: 1px solid rgba(255,232,184,0.18);
        display: none;
      }
      .iso-controls.is-open { display: block; }
    }
    .iso-ctl { margin-bottom: 11px; }
    .iso-ctl:last-child { margin-bottom: 0; }
    .iso-ctl[hidden] { display: none; }
    .iso-ctl-row { display: flex; justify-content: space-between; margin-bottom: 3px; }
    .iso-ctl-row .val { color: rgba(255,232,184,0.95); }
    .iso-ctl input[type="range"] { width: 100%; height: 3px; -webkit-appearance: none; appearance: none; background: rgba(255,232,184,0.2); outline: none; cursor: pointer; }
    .iso-ctl input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 12px; background: #38bdf8; border: 1px solid rgba(255,255,255,0.4); cursor: pointer; }
    .iso-ctl input[type="range"]::-moz-range-thumb { width: 12px; height: 12px; background: #38bdf8; border: 1px solid rgba(255,255,255,0.4); cursor: pointer; border-radius: 0; }
    .iso-ctl select { width: 100%; font: inherit; font-size: 11px; padding: 3px 4px; background: #0b1018; color: rgba(255,232,184,0.9); border: 1px solid rgba(255,232,184,0.2); cursor: pointer; }
    .iso-sep { margin: 12px 0 10px; border-top: 1px solid rgba(255,232,184,0.14); }
    .iso-check { display: flex; align-items: center; gap: 7px; cursor: pointer; user-select: none; }
    .iso-check input { accent-color: #38bdf8; cursor: pointer; }
    .iso-btn { width: 100%; padding: 6px 0; font: inherit; font-size: 11px; background: rgba(56,189,248,0.1); color: rgba(255,232,184,0.92); border: 1px solid rgba(56,189,248,0.4); cursor: pointer; }
    .iso-btn:hover { background: rgba(56,189,248,0.2); }
    .iso-btn:disabled { opacity: 0.4; cursor: default; }
    .iso-hint { margin-top: 10px; font-size: 10px; color: rgba(255,232,184,0.4); line-height: 1.5; }
    .map-foot { padding: 12px 28px; border-top: 1px solid rgba(255,232,184,0.12); font-size: 11px; color: rgba(255,232,184,0.45); display: flex; gap: 16px; flex-wrap: wrap; }
  </style>
</head>
<body>
  <DocsHeader />
  <div class="ex-layout">
    <ExamplesSidebar active="image" />
    <div class="ex-main">
      <header class="map-head">
        <h1>[ IMAGE → GLYPH ]</h1>
        <p>Drop or paste any image. Flat mode maps it onto a single textured quad; the relief modes escalate it into real 3D — luminance terraces, color-boundary fragments, or per-cell columns — so lighting, ink contours, and glyph effects run on the image's own structure. Drag to orbit.</p>
      </header>
      <div class="map-stage" id="stage">
        <div class="img-host" id="host"></div>
        <div class="drop-hint" id="hint">
          <b>Drop an image here</b>
          <span>or click to choose · or paste from clipboard</span>
        </div>
        <input type="file" id="file" accept="image/*" hidden />
        <button class="iso-ctl-toggle" type="button" id="ctl-toggle" aria-expanded="false" aria-controls="iso-controls">[ Controls ]</button>
        <div class="iso-controls" id="iso-controls">
          <h2>[ CONTROLS ]</h2>
          <div class="iso-ctl">
            <div class="iso-ctl-row"><span>density</span><span class="val" id="density-val">1.6</span></div>
            <input type="range" id="density" min="0.75" max="4" step="0.05" value="1.6" />
          </div>
          <div class="iso-ctl">
            <div class="iso-ctl-row"><span>glyph set</span></div>
            <select id="palette"></select>
          </div>
          <div class="iso-ctl">
            <label class="iso-check"><input type="checkbox" id="color" checked /> color</label>
          </div>
          <div class="iso-sep"></div>
          <div class="iso-ctl">
            <div class="iso-ctl-row"><span>relief</span></div>
            <select id="mode">
              <option value="flat">flat quad</option>
              <option value="steps">luminance terraces</option>
              <option value="regions">color regions</option>
              <option value="columns">columns</option>
            </select>
          </div>
          <div class="iso-ctl" id="ctl-depth" hidden>
            <div class="iso-ctl-row"><span>depth</span><span class="val" id="depth-val">0.25</span></div>
            <input type="range" id="depth" min="0.02" max="0.6" step="0.01" value="0.25" />
          </div>
          <div class="iso-ctl" id="ctl-steps" hidden>
            <div class="iso-ctl-row"><span>steps</span><span class="val" id="steps-val">5</span></div>
            <input type="range" id="steps" min="2" max="10" step="1" value="5" />
          </div>
          <div class="iso-ctl" id="ctl-threshold" hidden>
            <div class="iso-ctl-row"><span>fragment threshold</span><span class="val" id="threshold-val">0.12</span></div>
            <input type="range" id="threshold" min="0.02" max="0.4" step="0.01" value="0.12" />
          </div>
          <div class="iso-ctl" id="ctl-res" hidden>
            <div class="iso-ctl-row"><span>mesh resolution</span><span class="val" id="res-val">48</span></div>
            <input type="range" id="res" min="16" max="96" step="4" value="48" />
          </div>
          <div class="iso-ctl" id="ctl-light" hidden>
            <div class="iso-ctl-row"><span>lighting</span><span class="val" id="light-val">0.5</span></div>
            <input type="range" id="light" min="0" max="1" step="0.05" value="0.5" />
          </div>
          <div class="iso-sep"></div>
          <div class="iso-ctl">
            <div class="iso-ctl-row"><span>effect</span></div>
            <select id="effect"><option value="">none</option></select>
          </div>
          <div class="iso-ctl" id="ctl-blend" hidden>
            <div class="iso-ctl-row"><span>blend</span></div>
            <select id="blend">
              <option value="over">over</option>
              <option value="replace">replace</option>
            </select>
          </div>
          <div class="iso-ctl" id="ctl-speed" hidden>
            <div class="iso-ctl-row"><span>speed</span><span class="val" id="speed-val">1</span></div>
            <input type="range" id="speed" min="0" max="3" step="0.1" value="1" />
          </div>
          <div class="iso-sep"></div>
          <div class="iso-ctl">
            <button type="button" class="iso-btn" id="copy" disabled>copy</button>
          </div>
          <div class="iso-hint" id="dims"></div>
        </div>
      </div>
      <footer class="map-foot">
        <span>image → relief mesh · glyphcss per-cell sampling</span>
        <span id="status">no image</span>
      </footer>
    </div>
  </div>

  <script>
    import {
      createGlyphScene,
      createGlyphOrthographicCamera,
      createGlyphOrbitControls,
      WIREFRAME_PALETTES,
    } from "glyphcss";
    import type { GlyphEffectLayerHandle } from "glyphcss";
    import { GlyphEffectCatalog } from "@glyphcss/effects";
    import { buildReliefPolygons, sampleImageToGrid, type ReliefMode } from "../../lib/image-relief";
    import {
      createExampleQuerySync,
      readQueryBoolean,
      readQueryNumber,
      readQueryString,
    } from "../../lib/example-query-state";

    const stage = document.getElementById("stage") as HTMLElement;
    const host = document.getElementById("host") as HTMLElement;
    const hint = document.getElementById("hint") as HTMLElement;
    const fileInput = document.getElementById("file") as HTMLInputElement;
    const paletteSel = document.getElementById("palette") as HTMLSelectElement;
    const modeSel = document.getElementById("mode") as HTMLSelectElement;
    const effectSel = document.getElementById("effect") as HTMLSelectElement;
    const blendSel = document.getElementById("blend") as HTMLSelectElement;
    const copyBtn = document.getElementById("copy") as HTMLButtonElement;
    const dims = document.getElementById("dims") as HTMLElement;
    const statusEl = document.getElementById("status") as HTMLElement;

    // Mobile: [ Controls ] button toggles the bottom drawer (collapsed by default).
    const ctlToggle = document.getElementById("ctl-toggle");
    const ctlPanel = document.getElementById("iso-controls");
    ctlToggle?.addEventListener("click", () => {
      const open = ctlPanel?.classList.toggle("is-open") ?? false;
      ctlToggle.setAttribute("aria-expanded", String(open));
      ctlToggle.textContent = open ? "[ Close ]" : "[ Controls ]";
    });

    const paletteNames = Object.keys(WIREFRAME_PALETTES);
    for (const name of paletteNames) {
      const opt = document.createElement("option");
      opt.value = name; opt.textContent = name;
      paletteSel.appendChild(opt);
    }
    const effectIds = GlyphEffectCatalog.map((d) => d.id as string);
    for (const def of GlyphEffectCatalog) {
      const opt = document.createElement("option");
      opt.value = def.id; opt.textContent = def.label;
      effectSel.appendChild(opt);
    }

    const ctl = {
      density: document.getElementById("density") as HTMLInputElement,
      color: document.getElementById("color") as HTMLInputElement,
      depth: document.getElementById("depth") as HTMLInputElement,
      steps: document.getElementById("steps") as HTMLInputElement,
      threshold: document.getElementById("threshold") as HTMLInputElement,
      res: document.getElementById("res") as HTMLInputElement,
      light: document.getElementById("light") as HTMLInputElement,
      speed: document.getElementById("speed") as HTMLInputElement,
    };
    const BASE_FONT_SIZE = 13;
    const query = new URLSearchParams(window.location.search);
    ctl.density.value = String(readQueryNumber(query, "density", 1.6, { min: 0.75, max: 4, step: 0.05 }));
    paletteSel.value = readQueryString(query, "palette", "default", (value) => paletteNames.includes(value));
    ctl.color.checked = readQueryBoolean(query, "color", true);
    modeSel.value = readQueryString(query, "mode", "flat", (v) => ["flat", "steps", "regions", "columns"].includes(v));
    ctl.depth.value = String(readQueryNumber(query, "depth", 0.25, { min: 0.02, max: 0.6, step: 0.01 }));
    ctl.steps.value = String(readQueryNumber(query, "steps", 5, { min: 2, max: 10, step: 1 }));
    ctl.threshold.value = String(readQueryNumber(query, "threshold", 0.12, { min: 0.02, max: 0.4, step: 0.01 }));
    ctl.res.value = String(readQueryNumber(query, "res", 48, { min: 16, max: 96, step: 4 }));
    ctl.light.value = String(readQueryNumber(query, "light", 0.5, { min: 0, max: 1, step: 0.05 }));
    effectSel.value = readQueryString(query, "effect", "", (v) => effectIds.includes(v));
    blendSel.value = readQueryString(query, "blend", "over", (v) => v === "over" || v === "replace");
    ctl.speed.value = String(readQueryNumber(query, "speed", 1, { min: 0, max: 3, step: 0.1 }));

    function syncControlVisibility(): void {
      const mode = modeSel.value as ReliefMode;
      const relief = mode !== "flat";
      document.getElementById("ctl-depth")!.hidden = !relief;
      document.getElementById("ctl-steps")!.hidden = mode !== "steps";
      document.getElementById("ctl-threshold")!.hidden = mode !== "regions";
      document.getElementById("ctl-res")!.hidden = !relief;
      document.getElementById("ctl-light")!.hidden = !relief;
      const hasEffect = effectSel.value !== "";
      document.getElementById("ctl-blend")!.hidden = !hasEffect;
      document.getElementById("ctl-speed")!.hidden = !hasEffect;
    }

    function applyDensity(): void {
      const density = Math.max(0.1, parseFloat(ctl.density.value) || 1);
      document.getElementById("density-val")!.textContent = density.toFixed(2).replace(/\.?0+$/, "");
      host.style.fontSize = `${BASE_FONT_SIZE / density}px`;
    }
    function showVal(id: string, value: string): void {
      document.getElementById(`${id}-val`)!.textContent = value;
    }

    applyDensity();
    syncControlVisibility();

    const camera = createGlyphOrthographicCamera({ rotX: 0, rotY: 0, zoom: 8 });
    const scene = createGlyphScene(host, {
      mode: "solid",
      useColors: ctl.color.checked,
      glyphPalette: paletteSel.value,
      autoSize: true,
      doubleSided: true,
      camera,
      directionalLight: { direction: [0, 0, 1], intensity: 0 },
      ambientLight: { intensity: 1 },
    });
    createGlyphOrbitControls(scene, { drag: true, wheel: false });

    const querySync = createExampleQuerySync(() => ({
      density: Number(ctl.density.value),
      palette: paletteSel.value,
      color: ctl.color.checked,
      mode: modeSel.value,
      depth: Number(ctl.depth.value),
      steps: Number(ctl.steps.value),
      threshold: Number(ctl.threshold.value),
      res: Number(ctl.res.value),
      light: Number(ctl.light.value),
      effect: effectSel.value,
      blend: blendSel.value,
      speed: Number(ctl.speed.value),
    }));
    querySync.write();

    let meshHandle: ReturnType<typeof scene.add> | null = null;
    let sourceImg: HTMLImageElement | null = null;
    let textureUrl = "";
    let aspect = 1;
    let sampled: { rows: number; data: ImageData } | null = null;

    // Flat mode = full ambient so each texel passes through unshaded (the
    // original page behavior). Relief modes trade ambient for a key light so
    // the terraces and walls actually read as 3D.
    function applyLighting(): void {
      if (modeSel.value === "flat") {
        scene.setOptions({
          directionalLight: { direction: [0, 0, 1], intensity: 0 },
          ambientLight: { intensity: 1 },
        });
        return;
      }
      const l = Number(ctl.light.value);
      scene.setOptions({
        directionalLight: { direction: [0.45, 0.4, 0.8], intensity: l },
        ambientLight: { intensity: 1 - 0.55 * l },
      });
    }

    function fit(): void {
      const o = scene.getOptions();
      const cols = o.cols || 1, rows = o.rows || 1;
      const rect = host.getBoundingClientRect();
      const zoom = Math.min((0.98 * rect.width) / aspect, 0.98 * rect.height);
      if (Number.isFinite(zoom) && zoom > 0) { camera.zoom = zoom; scene.rerender(); }
      dims.textContent = `${cols} × ${rows} cells · ${paletteSel.value}`;
    }

    function rebuildMesh(): void {
      if (!sourceImg) return;
      const mode = modeSel.value as ReliefMode;
      const rows = Number(ctl.res.value);
      if (mode !== "flat" && (!sampled || sampled.rows !== rows)) {
        sampled = { rows, data: sampleImageToGrid(sourceImg, rows).data };
      }
      const grid = mode === "flat"
        ? new ImageData(1, 1)
        : sampled!.data;
      const result = buildReliefPolygons(grid, {
        mode,
        textureUrl,
        aspect,
        depth: Number(ctl.depth.value),
        steps: Number(ctl.steps.value),
        threshold: Number(ctl.threshold.value),
      });
      if (meshHandle) meshHandle.dispose();
      meshHandle = scene.add(result.polygons);
      statusEl.textContent = mode === "flat"
        ? `${sourceImg.naturalWidth}×${sourceImg.naturalHeight}`
        : `${sourceImg.naturalWidth}×${sourceImg.naturalHeight} · ${result.polygons.length} polys · ${result.regionCount} regions`;
      requestAnimationFrame(fit);
    }

    // Auto-tilt into 3D when leaving flat (only if the user hasn't orbited),
    // and back to head-on when returning to flat.
    let lastMode = modeSel.value;
    function onModeChange(): void {
      const mode = modeSel.value;
      if (mode !== "flat" && lastMode === "flat" && camera.rotX === 0 && camera.rotY === 0) {
        camera.rotX = 38; camera.rotY = 14;
      } else if (mode === "flat") {
        camera.rotX = 0; camera.rotY = 0;
      }
      lastMode = mode;
      syncControlVisibility();
      applyLighting();
      rebuildMesh();
      querySync.schedule();
    }

    // ── Effect layer ─────────────────────────────────────────────────────
    let effectLayer: GlyphEffectLayerHandle<Record<string, unknown>> | null = null;
    let effectHasClock = false;
    let effectTime = 0;
    let effectPrev = 0;
    let effectRaf = 0;

    function tickEffect(now: number): void {
      if (!effectLayer || effectLayer.disposed) return;
      const speed = Number(ctl.speed.value);
      effectTime += Math.min((now - effectPrev) / 1000, 0.1) * speed;
      effectPrev = now;
      if (speed > 0) effectLayer.params.time = effectTime;
      effectRaf = requestAnimationFrame(tickEffect);
    }

    function applyEffect(): void {
      if (effectLayer) { effectLayer.dispose(); effectLayer = null; }
      cancelAnimationFrame(effectRaf);
      const def = GlyphEffectCatalog.find((d) => d.id === effectSel.value);
      if (!def) { syncControlVisibility(); return; }
      const params: Record<string, unknown> = {};
      for (const [name, spec] of Object.entries(def.parameterSchema)) {
        if (name === "time") continue;
        params[name] = spec.default;
      }
      effectLayer = scene.addEffectLayer({
        effect: def,
        params,
        target: "surfaces",
        blend: blendSel.value as "over" | "replace",
      }) as GlyphEffectLayerHandle<Record<string, unknown>>;
      effectHasClock = "time" in def.parameterSchema;
      if (effectHasClock) {
        effectTime = 0;
        effectPrev = performance.now();
        effectRaf = requestAnimationFrame(tickEffect);
      }
      syncControlVisibility();
    }

    function loadFile(file: File): void {
      if (!file || !file.type.startsWith("image/")) return;
      const url = URL.createObjectURL(file);
      const im = new Image();
      im.onload = () => {
        aspect = im.naturalWidth / im.naturalHeight || 1;
        sourceImg = im;
        textureUrl = url;
        sampled = null;
        hint.style.display = "none";
        copyBtn.disabled = false;
        rebuildMesh();
      };
      im.src = url;
      statusEl.textContent = `loading ${file.name}…`;
    }

    // Controls
    ctl.density.addEventListener("input", () => {
      applyDensity();
      scene.fit();
      fit();
      querySync.schedule();
    });
    ctl.color.addEventListener("input", () => {
      scene.setOptions({ useColors: ctl.color.checked });
      querySync.schedule();
    });
    paletteSel.addEventListener("change", () => {
      scene.setOptions({ glyphPalette: paletteSel.value });
      querySync.schedule();
    });
    modeSel.addEventListener("change", onModeChange);
    for (const [input, label, fmt] of [
      [ctl.depth, "depth", (v: string) => v],
      [ctl.steps, "steps", (v: string) => v],
      [ctl.threshold, "threshold", (v: string) => v],
      [ctl.res, "res", (v: string) => v],
    ] as const) {
      input.addEventListener("input", () => {
        showVal(label, fmt(input.value));
        rebuildMesh();
        querySync.schedule();
      });
    }
    ctl.light.addEventListener("input", () => {
      showVal("light", ctl.light.value);
      applyLighting();
      querySync.schedule();
    });
    effectSel.addEventListener("change", () => { applyEffect(); querySync.schedule(); });
    blendSel.addEventListener("change", () => {
      effectLayer?.setOptions({ blend: blendSel.value as "over" | "replace" });
      querySync.schedule();
    });
    ctl.speed.addEventListener("input", () => {
      showVal("speed", ctl.speed.value);
      querySync.schedule();
    });

    // Restore URL-loaded relief/effect state.
    showVal("depth", ctl.depth.value);
    showVal("steps", ctl.steps.value);
    showVal("threshold", ctl.threshold.value);
    showVal("res", ctl.res.value);
    showVal("light", ctl.light.value);
    showVal("speed", ctl.speed.value);
    if (modeSel.value !== "flat") { camera.rotX = 38; camera.rotY = 14; lastMode = modeSel.value; }
    applyLighting();
    if (effectSel.value) applyEffect();

    // Drop / click / paste
    fileInput.addEventListener("change", () => { if (fileInput.files?.[0]) loadFile(fileInput.files[0]); });
    stage.addEventListener("click", (e) => { if (!meshHandle && (e.target === hint || (e.target as Element).closest(".drop-hint"))) fileInput.click(); });
    stage.addEventListener("dragover", (e) => { e.preventDefault(); stage.classList.add("dragover"); });
    stage.addEventListener("dragleave", () => stage.classList.remove("dragover"));
    stage.addEventListener("drop", (e) => {
      e.preventDefault(); stage.classList.remove("dragover");
      const f = e.dataTransfer?.files?.[0];
      if (f) loadFile(f);
    });
    window.addEventListener("paste", (e) => {
      const item = [...(e.clipboardData?.items ?? [])].find((it) => it.type.startsWith("image/"));
      const f = item?.getAsFile();
      if (f) loadFile(f);
    });
    window.addEventListener("resize", () => { if (meshHandle) requestAnimationFrame(fit); });

    // Copy both plain text and rich HTML (color survives a paste).
    copyBtn.addEventListener("click", async () => {
      const pre = scene.output;
      const text = pre.textContent ?? "";
      const cs = getComputedStyle(pre);
      const html =
        `<pre style="font-family:ui-monospace,'JetBrains Mono','SF Mono',Menlo,monospace;` +
        `white-space:pre;font-size:${cs.fontSize};line-height:${cs.lineHeight};background:#04060b;color:#e8edf2;margin:0;padding:10px">${pre.innerHTML}</pre>`;
      const done = () => { copyBtn.textContent = "copied!"; setTimeout(() => (copyBtn.textContent = "copy"), 1200); };
      try {
        const CI = (globalThis as { ClipboardItem?: typeof ClipboardItem }).ClipboardItem;
        if (CI && navigator.clipboard?.write) {
          await navigator.clipboard.write([new CI({
            "text/plain": new Blob([text], { type: "text/plain" }),
            "text/html": new Blob([html], { type: "text/html" }),
          })]);
        } else { await navigator.clipboard.writeText(text); }
        done();
      } catch { try { await navigator.clipboard.writeText(text); done(); } catch { /* blocked */ } }
    });
  </script>
</body>
</html>
