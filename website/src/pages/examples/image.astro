---
import ExampleLayout from "../../layouts/ExampleLayout.astro";
import { ImageExample } from "../../components/ImageExample";
const title = "glyphcss · Image → Glyph";
const description =
  "Drop or paste any image and watch it rasterise into shaded, colored ASCII — flat, or posterized into color-group shape plates that glyph effects land on, shape by shape.";
---

<ExampleLayout title={title} description={description} path="/examples/image/" image="/og/image.png" active="image"
  ><ImageExample client:load /></ExampleLayout
>
