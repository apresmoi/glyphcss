    bindCityRange(minHeightInput, minHeightValue, (value) => {
      cityConfig.minHeight = Math.round(value / 2) * 2;
      if (cityConfig.maxHeight < cityConfig.minHeight + 20) {
        cityConfig.maxHeight = Math.ceil((cityConfig.minHeight + 20) / 5) * 5;
        if (maxHeightInput) maxHeightInput.value = String(cityConfig.maxHeight);
        if (maxHeightValue) maxHeightValue.textContent = cityConfig.maxHeight.toFixed(0);
      }
      return cityConfig.minHeight.toFixed(0);
    });
    bindCityRange(maxHeightInput, maxHeightValue, (value) => {
      cityConfig.maxHeight = Math.round(value / 5) * 5;
      if (cityConfig.minHeight > cityConfig.maxHeight - 20) {
        cityConfig.minHeight = Math.floor((cityConfig.maxHeight - 20) / 2) * 2;
        if (minHeightInput) minHeightInput.value = String(cityConfig.minHeight);
        if (minHeightValue) minHeightValue.textContent = cityConfig.minHeight.toFixed(0);
      }
      return cityConfig.maxHeight.toFixed(0);
    });

    const transformGlyphFlow: TransformCells = (grid) => {
      const count = glyphPattern.length;
      const surfaceUv = grid.surfaceUv;
      if (count === 0 || !surfaceUv) return;
      const step = Math.floor(glyphTravelCells);
      const vertical = glyphMode === "rain" || glyphDirection === "up" || glyphDirection === "down";
      const alongOffset = vertical ? 1 : 0;
      const acrossOffset = vertical ? 0 : 1;
      const alongSign = glyphDirection === "right" || glyphDirection === "up" ? 1 : -1;

      if (glyphMode === "rain") {
        rainStepByLane.clear();
        if (rainComposition === "overlay") {
          for (let behind = 0; behind < rainTrailCells; behind++) {
            const strength = Math.pow(1 - behind / rainTrailCells, 1.4);
            rainLevelByDistance[behind] = Math.max(1, Math.ceil(strength * RAIN_FADE_LEVELS));
          }
        }
      }

      for (let i = 0; i < grid.char.length; i++) {
        const uvOffset = i * 2;
        const along = surfaceUv[uvOffset + alongOffset]!;
        const across = surfaceUv[uvOffset + acrossOffset]!;
        if (!Number.isFinite(along) || !Number.isFinite(across)) {
          if (glyphMode === "rain" && rainComposition === "mask") {
            grid.char[i] = " ";
            grid.color[i] = null;
          }
          continue;
        }
        const axisCell = Math.floor(along * alongSign);
        if (glyphMode === "repeat") {
          grid.char[i] = glyphPattern[positiveMod(axisCell - step, count)]!;
          continue;
        }
        const lane = Math.floor(across);
        let seed = rainSeedByLane.get(lane);
        if (seed === undefined) {
          seed = glyphHash(lane, 0x4ca1);
          rainSeedByLane.set(lane, seed);
        }
        const period = rainTrailCells * 3;
        let streamStep = rainStepByLane.get(lane);
        if (streamStep === undefined) {
          const speedUnit = ((seed >>> 16) & 0xffff) / 0xffff;
          const laneSpeed = rainMinCellsPerSecond
            + speedUnit * (rainMaxCellsPerSecond - rainMinCellsPerSecond);
          let motion = rainMotionByLane.get(lane);
          if (motion === undefined) {
            motion = { position: seed % period, lastTime: rainElapsedSeconds };
            rainMotionByLane.set(lane, motion);
          } else {
            motion.position += Math.max(0, rainElapsedSeconds - motion.lastTime) * laneSpeed;
            motion.lastTime = rainElapsedSeconds;
          }
          streamStep = Math.floor(motion.position);
          rainStepByLane.set(lane, streamStep);
        }
        const chainGlyph = glyphPattern[positiveMod(axisCell - streamStep + ((seed >>> 8) % count), count)]!;
        const baseGlyph = grid.char[i]!;
        const activeLane = (seed & 0xffff) / 0x1_0000 < rainStreamDensity;
        const behind = positiveMod(streamStep - axisCell, period);
        const inTrail = activeLane && behind < rainTrailCells;

        if (rainComposition === "mask") {
          if (!inTrail || baseGlyph === " ") {
            grid.char[i] = " ";
            grid.color[i] = null;
            continue;
          }
          grid.char[i] = chainGlyph;
          continue;
        }

        grid.char[i] = chainGlyph;
        if (!inTrail) continue;
        const level = rainLevelByDistance[behind]!;
        grid.color[i] = rainColor(grid.color[i] ?? null, level, behind === 0);
      }
    };

    function rotationAngle(axis: RotationAxis = rotationAxis): number {
      return axis === "x" ? camera.rotX : camera.rotY;
    }

    function setRotationAngle(value: number): void {
      if (rotationAxis === "x") camera.rotX = value;
      else camera.rotY = positiveMod(value, FULL_ROTATION_DEGREES);
    }

    function formatAngle(value: number): string {
      return Number.isInteger(value) ? value.toFixed(0) : value.toFixed(1);
    }

    function captureRotationSequence(): void {
      rotationOrigin = rotationAngle();
      tiltTravelDegrees = 0;
      if (rotationAxis === "y") {
        rotationOrigin = positiveMod(rotationOrigin, FULL_ROTATION_DEGREES);
        rotationKeyframes = [0, FULL_ROTATION_DEGREES];
        rotationSegments = [];
        rotationLoopDegrees = FULL_ROTATION_DEGREES;
        if (tiltSequenceValue) tiltSequenceValue.textContent = "0° → 360° → …";
        return;
      }
      rotationKeyframes = ROTATION_KEYFRAME_OFFSETS.map((offset) => rotationOrigin + offset);
      rotationSegments = rotationKeyframes.slice(0, -1).map((from, index) => {
        const to = rotationKeyframes[index + 1]!;
        return { from, to, distance: Math.abs(to - from) };
      }).filter((segment) => segment.distance > 0);
      rotationLoopDegrees = rotationSegments.reduce((total, segment) => total + segment.distance, 0);
      if (tiltSequenceValue) {
        tiltSequenceValue.textContent = rotationKeyframes.map((value) => `${formatAngle(value)}°`).join(" → ");
      }
    }

    function syncRotationAxisButtons(): void {
      $("rotation-axis")?.querySelectorAll<HTMLButtonElement>("[data-rotation-axis]").forEach((button) => {
        button.classList.toggle("active", button.dataset.rotationAxis === rotationAxis);
      });
    }

    function syncTiltReadout(now: number, force = false): void {
      if (!force && now - lastTiltReadoutAt < 100) return;
      lastTiltReadoutAt = now;
      if (rotationAxis === "x") {
        if (tiltInput) tiltInput.value = camera.rotX.toFixed(2);
        if (tiltValue) tiltValue.textContent = camera.rotX.toFixed(1);
      } else {
        if (orbitInput) orbitInput.value = camera.rotY.toFixed(2);
        if (orbitValue) orbitValue.textContent = camera.rotY.toFixed(1);
      }
    }

    function applyTiltSequence(now: number, forceReadout = false): void {
      if (rotationLoopDegrees <= 0) return;
      const travel = positiveMod(tiltTravelDegrees, rotationLoopDegrees);
      if (rotationAxis === "y") {
        setRotationAngle(rotationOrigin + travel);
        syncTiltReadout(now, forceReadout);
        return;
      }
      let segmentStart = 0;
      const segment = rotationSegments.find((candidate) => {
        if (travel < segmentStart + candidate.distance) return true;
        segmentStart += candidate.distance;
        return false;
      }) ?? rotationSegments[rotationSegments.length - 1]!;
      const progress = (travel - segmentStart) / segment.distance;
      setRotationAngle(segment.from + (segment.to - segment.from) * progress);
      syncTiltReadout(now, forceReadout);
    }

    function hydrateControlValues(): void {
      if (speedInput) speedInput.value = String(speed);
      if (speedValue) speedValue.textContent = `${speed.toFixed(2)}×`;
      if (densityInput) densityInput.value = String(density);
      if (densityValue) densityValue.textContent = density.toFixed(2);
      if (lodInput) lodInput.value = String(motionLod);
      if (lodValue) lodValue.textContent = `${motionLod.toFixed(2)}×`;
      if (tiltInput) tiltInput.value = String(camera.rotX);
      if (tiltValue) tiltValue.textContent = formatAngle(camera.rotX);
      if (orbitInput) orbitInput.value = String(camera.rotY);
      if (orbitValue) orbitValue.textContent = formatAngle(camera.rotY);
      if (zoomInput) zoomInput.value = String(camera.zoom);
      if (zoomValue) zoomValue.textContent = `${camera.zoom.toFixed(2)}×`;
      if (tiltSpeedInput) tiltSpeedInput.value = String(tiltDegreesPerSecond);
      if (tiltSpeedValue) tiltSpeedValue.textContent = `${tiltDegreesPerSecond.toFixed(0)}°/s`;

      const setCityValue = (
        input: HTMLInputElement | null,
        readout: HTMLElement | null,
        value: number,
        display = String(value),
      ) => {
        if (input) input.value = String(value);
        if (readout) readout.textContent = display;
      };
      setCityValue(depthBlocksInput, depthBlocksValue, cityConfig.depthBlocks);
      setCityValue(runBlocksInput, runBlocksValue, cityConfig.runBlocks);
      setCityValue(blockDepthInput, blockDepthValue, cityConfig.blockDepth);
      setCityValue(blockWidthInput, blockWidthValue, cityConfig.blockWidth);
      setCityValue(streetInput, streetValue, cityConfig.street);
      setCityValue(buildingSizeInput, buildingSizeValue, cityConfig.buildingSize);
      setCityValue(buildingGapInput, buildingGapValue, cityConfig.gap);
      setCityValue(mergeInput, mergeValue, cityConfig.merge, `${Math.round(cityConfig.merge * 100)}%`);
      setCityValue(minHeightInput, minHeightValue, cityConfig.minHeight);
      setCityValue(maxHeightInput, maxHeightValue, cityConfig.maxHeight);

      if (glyphPatternInput) glyphPatternInput.value = glyphPattern.join("");
      if (glyphSpeedInput) glyphSpeedInput.value = String(glyphCellsPerSecond);
      if (glyphSpeedValue) glyphSpeedValue.textContent = `${glyphCellsPerSecond.toFixed(0)} cells/s`;
      if (rainSpeedMinInput) rainSpeedMinInput.value = String(rainMinCellsPerSecond);
      if (rainSpeedMinValue) rainSpeedMinValue.textContent = `${rainMinCellsPerSecond.toFixed(0)} cells/s`;
      if (rainSpeedMaxInput) rainSpeedMaxInput.value = String(rainMaxCellsPerSecond);
      if (rainSpeedMaxValue) rainSpeedMaxValue.textContent = `${rainMaxCellsPerSecond.toFixed(0)} cells/s`;
      if (rainTrailInput) rainTrailInput.value = String(rainTrailCells);
      if (rainTrailValue) rainTrailValue.textContent = `${rainTrailCells.toFixed(0)} cells`;
      if (rainStreamInput) rainStreamInput.value = String(rainStreamDensity * 100);
      if (rainStreamValue) rainStreamValue.textContent = `${(rainStreamDensity * 100).toFixed(0)}%`;
      if (monoColorInput) monoColorInput.value = monoColor;
      if (monoColorValue) monoColorValue.textContent = monoColor.toUpperCase();

      $("color-mode")?.querySelectorAll<HTMLButtonElement>("[data-color]").forEach((button) => {
        button.classList.toggle("active", (button.dataset.color === "true") === useColors);
      });
      $("glyph-mode")?.querySelectorAll<HTMLButtonElement>("[data-glyph-mode]").forEach((button) => {
        button.classList.toggle("active", button.dataset.glyphMode === glyphMode);
      });
      $("rain-composition")?.querySelectorAll<HTMLButtonElement>("[data-rain-composition]").forEach((button) => {
        button.classList.toggle("active", button.dataset.rainComposition === rainComposition);
      });
      if (monoColorControl) monoColorControl.hidden = useColors;
      if (glyphSpeedControl) glyphSpeedControl.hidden = glyphMode === "rain";
      if (rainSpeedMinControl) rainSpeedMinControl.hidden = glyphMode !== "rain";
      if (rainSpeedMaxControl) rainSpeedMaxControl.hidden = glyphMode !== "rain";
      if (rainTrailControl) rainTrailControl.hidden = glyphMode !== "rain";
      if (rainCompositionControl) rainCompositionControl.hidden = glyphMode !== "rain";
      if (rainStreamControl) rainStreamControl.hidden = glyphMode !== "rain";
    }

    hydrateControlValues();
    captureRotationSequence();
    syncRotationAxisButtons();
    syncGlyphDirectionButtons();
    updatePlayLabel();
    updateTiltPlayLabel();
    updateGlyphPlayLabel();
    if (glyphMode !== "shaded") scene.setOptions({ transformCells: transformGlyphFlow });
    if (tiltPlaying) setFaceOptimization(false);
    cityQuerySync.write();
    playButton?.addEventListener("click", () => {
      playing = !playing;
      updatePlayLabel();
      const rendered = updateInteractionState();
      if (!rendered) dirty = true;
    });

    tiltPlayButton?.addEventListener("click", () => {
      tiltPlaying = !tiltPlaying;
      updateTiltPlayLabel();
      if (tiltPlaying) {
        resetAnimationClock = true;
        applyTiltSequence(performance.now(), true);
        setFaceOptimization(false);
      } else {
        syncTiltReadout(performance.now(), true);
        recomputeBackfaces();
        markCameraDirty();
      }
      updateInteractionState();
    });

    $("rotation-axis")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-rotation-axis]");
      if (!button) return;
      const nextAxis = button.dataset.rotationAxis as RotationAxis;
      if (nextAxis === rotationAxis) return;
      if (tiltPlaying) {
        tiltPlaying = false;
        updateTiltPlayLabel();
        recomputeBackfaces();
      }
      rotationAxis = nextAxis;
      captureRotationSequence();
      syncRotationAxisButtons();
      updateTiltPlayLabel();
      updateInteractionState();
      markCameraDirty();
    });

    tiltSpeedInput?.addEventListener("input", () => {
      tiltDegreesPerSecond = Number(tiltSpeedInput.value);
      if (tiltSpeedValue) tiltSpeedValue.textContent = `${tiltDegreesPerSecond.toFixed(0)}°/s`;
    });

    function syncGlyphDirectionButtons(): void {
      $("glyph-direction")?.querySelectorAll<HTMLButtonElement>("[data-glyph-direction]").forEach((button) => {
        const direction = button.dataset.glyphDirection as GlyphFlowDirection;
        button.disabled = glyphMode === "rain" && (direction === "left" || direction === "right");
        button.classList.toggle("active", direction === glyphDirection);
      });
    }

    glyphPatternInput?.addEventListener("input", () => {
      const next = parseGlyphPattern(glyphPatternInput.value);
      const sanitized = next.join("");
      if (glyphPatternInput.value !== sanitized) glyphPatternInput.value = sanitized;
      if (next.length === 0) return;
      glyphPattern = next;
      resetGlyphTravel();
      if (glyphMode !== "shaded") dirty = true;
    });
    glyphPatternInput?.addEventListener("blur", () => {
      if (parseGlyphPattern(glyphPatternInput.value).length === 0) {
        glyphPatternInput.value = glyphPattern.join("");
      }
    });

    $("glyph-mode")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-glyph-mode]");
      if (!button) return;
      const nextMode = button.dataset.glyphMode as GlyphFlowMode;
      if (nextMode === glyphMode) return;
      glyphMode = nextMode;
      resetGlyphTravel();
      button.parentElement?.querySelectorAll("button").forEach((item) => {
        item.classList.toggle("active", item === button);
      });
      if (glyphMode === "rain" && (glyphDirection === "left" || glyphDirection === "right")) {
        glyphDirection = "down";
      }
      syncGlyphDirectionButtons();
      if (glyphMode === "shaded") glyphPlaying = false;
      if (glyphSpeedControl) glyphSpeedControl.hidden = glyphMode === "rain";
      if (rainSpeedMinControl) rainSpeedMinControl.hidden = glyphMode !== "rain";
      if (rainSpeedMaxControl) rainSpeedMaxControl.hidden = glyphMode !== "rain";
      if (rainTrailControl) rainTrailControl.hidden = glyphMode !== "rain";
      if (rainCompositionControl) rainCompositionControl.hidden = glyphMode !== "rain";
      if (rainStreamControl) rainStreamControl.hidden = glyphMode !== "rain";
      updateGlyphPlayLabel();
      scene.setOptions({ transformCells: glyphMode === "shaded" ? undefined : transformGlyphFlow });
      updateInteractionState();
    });

    $("glyph-direction")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-glyph-direction]");
      if (!button || button.disabled) return;
      glyphDirection = button.dataset.glyphDirection as GlyphFlowDirection;
      resetGlyphTravel();
      syncGlyphDirectionButtons();
      if (glyphMode !== "shaded") dirty = true;
    });

    glyphSpeedInput?.addEventListener("input", () => {
      glyphCellsPerSecond = Number(glyphSpeedInput.value);
      if (glyphSpeedValue) glyphSpeedValue.textContent = `${glyphCellsPerSecond.toFixed(0)} cells/s`;
    });

    rainSpeedMinInput?.addEventListener("input", () => {
      rainMinCellsPerSecond = Number(rainSpeedMinInput.value);
      if (rainMinCellsPerSecond > rainMaxCellsPerSecond) {
        rainMaxCellsPerSecond = rainMinCellsPerSecond;
        if (rainSpeedMaxInput) rainSpeedMaxInput.value = String(rainMaxCellsPerSecond);
      }
      if (rainSpeedMinValue) rainSpeedMinValue.textContent = `${rainMinCellsPerSecond.toFixed(0)} cells/s`;
      if (rainSpeedMaxValue) rainSpeedMaxValue.textContent = `${rainMaxCellsPerSecond.toFixed(0)} cells/s`;
      if (glyphMode === "rain") dirty = true;
    });

    rainSpeedMaxInput?.addEventListener("input", () => {
      rainMaxCellsPerSecond = Number(rainSpeedMaxInput.value);
      if (rainMaxCellsPerSecond < rainMinCellsPerSecond) {
        rainMinCellsPerSecond = rainMaxCellsPerSecond;
        if (rainSpeedMinInput) rainSpeedMinInput.value = String(rainMinCellsPerSecond);
      }
      if (rainSpeedMinValue) rainSpeedMinValue.textContent = `${rainMinCellsPerSecond.toFixed(0)} cells/s`;
      if (rainSpeedMaxValue) rainSpeedMaxValue.textContent = `${rainMaxCellsPerSecond.toFixed(0)} cells/s`;
      if (glyphMode === "rain") dirty = true;
    });

    rainTrailInput?.addEventListener("input", () => {
      rainTrailCells = Number(rainTrailInput.value);
      if (rainTrailValue) rainTrailValue.textContent = `${rainTrailCells.toFixed(0)} cells`;
      if (glyphMode === "rain") dirty = true;
    });

    $("rain-composition")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-rain-composition]");
      if (!button) return;
      rainComposition = button.dataset.rainComposition as RainComposition;
      button.parentElement?.querySelectorAll("button").forEach((item) => {
        item.classList.toggle("active", item === button);
      });
      if (glyphMode === "rain") dirty = true;
    });

    rainStreamInput?.addEventListener("input", () => {
      rainStreamDensity = Number(rainStreamInput.value) / 100;
      if (rainStreamValue) rainStreamValue.textContent = `${(rainStreamDensity * 100).toFixed(0)}%`;
      if (glyphMode === "rain") dirty = true;
    });

    glyphPlayButton?.addEventListener("click", () => {
      if (glyphMode === "shaded") return;
      glyphPlaying = !glyphPlaying;
      if (glyphPlaying) resetAnimationClock = true;
      updateGlyphPlayLabel();
      const rendered = updateInteractionState();
      if (!rendered) dirty = true;
    });

    speedInput?.addEventListener("input", () => {
      speed = Number(speedInput.value);
      if (speedValue) speedValue.textContent = `${speed.toFixed(2)}×`;
      const rendered = updateInteractionState();
      if (!rendered) dirty = true;
    });

    densityInput?.addEventListener("input", () => {
      density = Number(densityInput.value);
      if (densityValue) densityValue.textContent = density.toFixed(2);
      const restoreLod = lodActive;
      if (restoreLod) {
        scene.setInteracting(false);
        lodActive = false;
      }
      scene.output.style.fontSize = `${BASE_FONT_SIZE / density}px`;
      scene.fit();
      queueMicrotask(() => {
        if (restoreLod && (animating() || dragging || wheelActive)) {
          scene.setInteracting(true);
          lodActive = true;
        }
        markCameraDirty();
      });
    });

    lodInput?.addEventListener("input", () => {
      motionLod = Number(lodInput.value);
      if (lodValue) lodValue.textContent = `${motionLod.toFixed(2)}×`;
      const restoreLod = lodActive;
      if (restoreLod) {
        scene.setInteracting(false);
        lodActive = false;
      }
      scene.setOptions({ interactiveDownscale: motionLod });
      queueMicrotask(() => {
        if (restoreLod && (animating() || dragging || wheelActive)) {
          scene.setInteracting(true);
          lodActive = true;
        }
        markCameraDirty();
      });
    });

    function syncCameraControls(): void {
      if (tiltInput) tiltInput.value = String(Math.round(camera.rotX));
      const displayRotY = Math.round(positiveMod(camera.rotY, FULL_ROTATION_DEGREES)) % FULL_ROTATION_DEGREES;
      if (orbitInput) orbitInput.value = String(displayRotY);
      if (zoomInput) zoomInput.value = camera.zoom.toFixed(2);
      if (tiltValue) tiltValue.textContent = String(Math.round(camera.rotX));
      if (orbitValue) orbitValue.textContent = String(displayRotY);
      if (zoomValue) zoomValue.textContent = `${camera.zoom.toFixed(2)}×`;
    }

    function finishManualRotation(axis: RotationAxis): void {
      if (axis === rotationAxis) {
        if (tiltPlaying) {
          tiltPlaying = false;
          updateTiltPlayLabel();
          updateInteractionState();
        }
        captureRotationSequence();
      }
      recomputeBackfaces();
      markCameraDirty();
    }

    tiltInput?.addEventListener("input", () => {
      camera.rotX = Number(tiltInput.value);
      if (tiltValue) tiltValue.textContent = String(Math.round(camera.rotX));
      finishManualRotation("x");
    });

    orbitInput?.addEventListener("input", () => {
      camera.rotY = positiveMod(Number(orbitInput.value), FULL_ROTATION_DEGREES);
      if (orbitValue) orbitValue.textContent = String(Math.round(camera.rotY));
      finishManualRotation("y");
    });

    zoomInput?.addEventListener("input", () => {
      camera.zoom = Number(zoomInput.value);
      if (zoomValue) zoomValue.textContent = `${camera.zoom.toFixed(2)}×`;
      markCameraDirty();
    });

    monoColorInput?.addEventListener("input", () => {
      monoColor = monoColorInput.value;
      scene.output.style.color = monoColor;
      if (monoColorValue) monoColorValue.textContent = monoColor.toUpperCase();
    });

    $("color-mode")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-color]");
      if (!button) return;
      useColors = button.dataset.color === "true";
      button.parentElement?.querySelectorAll("button").forEach((item) => {
        item.classList.toggle("active", item === button);
      });
      if (monoColorControl) monoColorControl.hidden = useColors;
      if (useColors) scene.output.style.removeProperty("color");
      else scene.output.style.color = monoColor;
      scene.setOptions({ useColors });
    });

    const syncControlQuery = () => cityQuerySync.schedule();
    $("city-controls")?.addEventListener("input", syncControlQuery);
    $("city-controls")?.addEventListener("change", syncControlQuery);
    $("city-controls")?.addEventListener("click", syncControlQuery);

    const controlToggle = $("ctl-toggle");
    const controlPanel = $("city-controls");
    controlToggle?.addEventListener("click", () => {
      const open = controlPanel?.classList.toggle("is-open") ?? false;
      controlToggle.setAttribute("aria-expanded", String(open));
      controlToggle.textContent = open ? "[ Close ]" : "[ Controls ]";
    });

    let activePointer: number | null = null;
    let lastX = 0;
    let lastY = 0;
    host.addEventListener("pointerdown", (event) => {
      if (activePointer !== null || event.button !== 0) return;
      activePointer = event.pointerId;
      lastX = event.clientX;
      lastY = event.clientY;
      dragging = true;
      if (tiltPlaying) {
        tiltPlaying = false;
        updateTiltPlayLabel();
        syncTiltReadout(performance.now(), true);
      }
      setFaceOptimization(false);
      updateInteractionState();
      host.setPointerCapture(event.pointerId);
    });
    host.addEventListener("pointermove", (event) => {
      if (activePointer !== event.pointerId) return;
      const events = event.getCoalescedEvents?.() ?? [event];
      const latest = events[events.length - 1]!;
      const dx = latest.clientX - lastX;
      const dy = latest.clientY - lastY;
      lastX = latest.clientX;
      lastY = latest.clientY;
      camera.rotY = positiveMod(camera.rotY - dx * 0.18, FULL_ROTATION_DEGREES);
      camera.rotX = clamp(camera.rotX - dy * 0.18, 25, 82);
      syncCameraControls();
      markCameraDirty();
    });
    const releasePointer = (event: PointerEvent) => {
      if (activePointer !== event.pointerId) return;
      activePointer = null;
      dragging = false;
      try { host.releasePointerCapture(event.pointerId); } catch {}
      captureRotationSequence();
      setFaceOptimization(true);
      updateInteractionState();
      cityQuerySync.schedule();
    };
    host.addEventListener("pointerup", releasePointer);
    host.addEventListener("pointercancel", releasePointer);
    host.addEventListener("wheel", (event) => {
      event.preventDefault();
      camera.zoom = clamp(camera.zoom * Math.exp(-event.deltaY * 0.001), 0.7, 4);
      wheelActive = true;
      syncCameraControls();
      updateInteractionState();
      markCameraDirty();
      if (wheelTimer) clearTimeout(wheelTimer);
      wheelTimer = setTimeout(() => {
        wheelTimer = null;
        wheelActive = false;
        updateInteractionState();
        markCameraDirty();
        cityQuerySync.schedule();
      }, 140);
    }, { passive: false });

    let stageVisible = true;
    const stageObserver = typeof IntersectionObserver === "undefined"
      ? null
      : new IntersectionObserver(([entry]) => {
          const visible = entry?.isIntersecting ?? true;
          if (visible !== stageVisible) resetAnimationClock = true;
          stageVisible = visible;
          markCameraDirty();
        }, { threshold: 0.01 });
    stageObserver?.observe(host);
    document.addEventListener("visibilitychange", () => {
      resetAnimationClock = true;
      markCameraDirty();
    });
    prefersReducedMotion.addEventListener("change", (event) => {
      if (!event.matches || (!playing && !tiltPlaying && !glyphPlaying)) return;
      playing = false;
      tiltPlaying = false;
      glyphPlaying = false;
      updatePlayLabel();
      updateTiltPlayLabel();
      updateGlyphPlayLabel();
      syncTiltReadout(performance.now(), true);
      recomputeBackfaces();
      updateInteractionState();
      dirty = true;
      cityQuerySync.schedule();
    });

    const polyCount = $("poly-count");
    const fpsValue = $("fps");
    const rasterValue = $("raster-ms");
    const domValue = $("dom-ms");
    const cellCount = $("cell-count");
    updateCityReadouts();

    let renderedFrames = 0;
    let sampleStarted = performance.now();
    function average(values: number[]): number {
      if (values.length === 0) return 0;
      return values.reduce((sum, value) => sum + value, 0) / values.length;
    }
    function updateStats(now: number): void {
      const elapsed = now - sampleStarted;
      if (elapsed < 650) return;
      const rasterSamples = perf.raster?.splice(0) ?? [];
      const domSamples = perf.dom?.splice(0) ?? [];
      perf.polys?.splice(0);
      const options = scene.getOptions();
      const activePolys = city.polygons.reduce((count, polygon) => count + (polygon.hidden ? 0 : 1), 0);
      if (fpsValue) fpsValue.textContent = animating() && stageVisible && !document.hidden
        ? ((renderedFrames * 1000) / elapsed).toFixed(0)
        : "paused";
      if (rasterValue) rasterValue.textContent = rasterSamples.length ? `${average(rasterSamples).toFixed(1)} ms` : "—";
      if (domValue) domValue.textContent = domSamples.length ? `${average(domSamples).toFixed(1)} ms` : "—";
      if (polyCount) polyCount.textContent = `${activePolys.toLocaleString()} / ${city.polygons.length.toLocaleString()}`;
      if (cellCount) cellCount.textContent = `${options.cols ?? 0}×${options.rows ?? 0}`;
      renderedFrames = 0;
      sampleStarted = now;
    }

    let lastFrame = performance.now();
    let cullFrame = 0;
    function frame(now: number): void {
      requestAnimationFrame(frame);
      const canAnimate = animating() && stageVisible && !document.hidden;
      const elapsedMs = resetAnimationClock ? 0 : Math.max(0, now - lastFrame);
      const dt = canAnimate ? Math.min(elapsedMs / 1000, 0.05) : 0;
      resetAnimationClock = false;
      lastFrame = now;

      if (canAnimate && moving()) {
        cameraY -= dt * (city.spanY / CITY.loopSeconds) * speed;
        camera.target = toWorld(0, cameraY, 0);
        if (recycleRows()) forceCull = true;
        dirty = true;
      }

      if (canAnimate && tiltPlaying) {
        tiltTravelDegrees = positiveMod(
          tiltTravelDegrees + (elapsedMs / 1000) * tiltDegreesPerSecond,
          rotationLoopDegrees,
        );
        applyTiltSequence(now);
        dirty = true;
      }

      if (canAnimate && glyphMoving()) {
        if (glyphMode === "rain") {
          const cadence = rainMaxCellsPerSecond * 1.25;
          const previousStep = Math.floor(rainElapsedSeconds * cadence);
          rainElapsedSeconds += elapsedMs / 1000;
          if (Math.floor(rainElapsedSeconds * cadence) !== previousStep) dirty = true;
        } else {
          const previousStep = Math.floor(glyphTravelCells);
          glyphTravelCells += (elapsedMs / 1000) * glyphCellsPerSecond;
          if (Math.floor(glyphTravelCells) !== previousStep) dirty = true;
        }
      }

      if (dirty) {
        cullFrame++;
        if (forceCull || cullFrame % 4 === 0) {
          refreshRowVisibility(forceCull);
          forceCull = false;
        }
        scene.rerender();
        renderedFrames++;
        dirty = false;
      }
      updateStats(now);
    }

    queueMicrotask(() => {
      requestAnimationFrame((now) => {
        $("loading")?.remove();
        updateInteractionState();
        lastFrame = now;
        requestAnimationFrame(frame);
      });
    });

    (window as typeof window & { __cityLab?: unknown }).__cityLab = {
      camera,
      scene,
      mesh: cityMesh,
      perf,
      get city() { return city; },
      get config() { return { ...cityConfig }; },
      get cameraY() { return cameraY; },
      get rebuildRevision() { return rebuildRevision; },
      get rotationAnimation() {
        return {
          axis: rotationAxis,
          origin: rotationOrigin,
          keyframes: [...rotationKeyframes],
          travelDegrees: tiltTravelDegrees,
          loopDegrees: rotationLoopDegrees,
          playing: tiltPlaying,
        };
      },
      diagnostics() {
        return {
          polygonCount: city.polygons.length,
          meshPolygonCount: cityMesh.polygons.length,
          chunkCount: city.chunks.length,
          visibleChunkCount: city.chunks.filter((chunk) => chunk.visible).length,
          rowMapLength: city.rowForPolygon.length,
          backfaceLength: city.backfaceHidden.length,
          invalidChunkRanges: city.chunks.filter((chunk) => (
            chunk.start < 0 || chunk.start > chunk.end || chunk.end > city.polygons.length
          )).length,
        };
      },
    };
  </script>
</body>
</html>
