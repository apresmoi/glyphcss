    function moving(): boolean {
      return playing && speed > 0;
    }

    function glyphMoving(): boolean {
      return glyphPlaying && (
        glyphMode === "rain"
        || (glyphMode === "repeat" && glyphPattern.length > 1)
      );
    }

    function animating(): boolean {
      return moving() || tiltPlaying || glyphMoving();
    }

    function updatePlayLabel(): void {
      if (playButton) playButton.textContent = playing ? "[ Pause motion ]" : "[ Play motion ]";
    }

    function updateTiltPlayLabel(): void {
      if (!tiltPlayButton) return;
      const animation = rotationAxis === "x" ? "rotation sequence" : "continuous rotation";
      tiltPlayButton.textContent = tiltPlaying ? `[ Pause ${animation} ]` : `[ Play ${animation} ]`;
      tiltPlayButton.setAttribute("aria-pressed", String(tiltPlaying));
    }

    function updateGlyphPlayLabel(): void {
      if (!glyphPlayButton) return;
      glyphPlayButton.disabled = glyphMode === "shaded";
      glyphPlayButton.textContent = glyphPlaying ? "[ Pause glyph flow ]" : "[ Play glyph flow ]";
      glyphPlayButton.setAttribute("aria-pressed", String(glyphPlaying));
    }

    function updateInteractionState(): boolean {
      const active = animating() || dragging || wheelActive;
      if (active === lodActive) return false;
      scene.setInteracting(active);
      lodActive = active;
      forceCull = true;
      return true;
    }

    function markCameraDirty(): void {
      dirty = true;
      forceCull = true;
    }

    function setFaceOptimization(enabled: boolean): void {
      if (enabled) recomputeBackfaces();
      else {
        faceOptimization = false;
        applyAllVisibility();
      }
      markCameraDirty();
    }

    function parseGlyphPattern(value: string): string[] {
      const safe = Array.from(value.toUpperCase()).filter((character) => {
        const code = character.charCodeAt(0);
        return character.length === 1
          && code >= 33
          && code <= 126
          && character !== "<"
          && character !== ">"
          && character !== "&";
      });
      return safe;
    }

    function resetGlyphTravel(): void {
      glyphTravelCells = 0;
      rainElapsedSeconds = 0;
      rainMotionByLane.clear();
    }

    function positiveMod(value: number, modulus: number): number {
      return ((value % modulus) + modulus) % modulus;
    }

    function glyphHash(a: number, b: number): number {
      let hash = Math.imul(a + 1, -1640531527) ^ Math.imul(b + 1, -2048144789);
      hash ^= hash >>> 16;
      return hash >>> 0;
    }

    const rainLevelByDistance = new Uint8Array(RAIN_MAX_TRAIL_CELLS);
    const rainSeedByLane = new Map<number, number>();
    const rainStepByLane = new Map<number, number>();
    const rainMotionByLane = new Map<number, { position: number; lastTime: number }>();
    const rainColorCache = new Map<string, string[]>();
    function rainColor(base: string | null, level: number, head: boolean): string | null {
      if (base === null) return null;
      const cached = rainColorCache.get(base);
      const slot = head ? RAIN_FADE_LEVELS + 1 : level;
      if (cached) return cached[slot]!;
      const parsed = parseColor(base);
      if (!parsed) return base;
      const byte = (channel: number) => clampChannel(channel).toString(16).padStart(2, "0");
      const colors = new Array<string>(RAIN_FADE_LEVELS + 2);
      for (let current = 1; current <= RAIN_FADE_LEVELS + 1; current++) {
        const isHead = current === RAIN_FADE_LEVELS + 1;
        const target = isHead ? RAIN_HEAD : RAIN_ACCENT;
        const normalizedLevel = current / RAIN_FADE_LEVELS;
        const strength = isHead ? 0.92 : 0.68 * normalizedLevel * normalizedLevel;
        const screen = (channel: number, tint: number) => (
          255 - (255 - channel) * (1 - (tint / 255) * strength)
        );
        colors[current] = `#${byte(screen(parsed.rgb[0], target[0]))}${byte(screen(parsed.rgb[1], target[1]))}${byte(screen(parsed.rgb[2], target[2]))}`;
      }
      rainColorCache.set(base, colors);
      return colors[slot]!;
    }

    function updateCityReadouts(): void {
      const activePolygons = city.polygons.reduce((count, polygon) => count + (polygon.hidden ? 0 : 1), 0);
      const buildingCount = $("building-count");
      const polygonCount = $("poly-count");
      if (buildingCount) buildingCount.textContent = city.buildingCount.toLocaleString();
      if (polygonCount) polygonCount.textContent = `${activePolygons.toLocaleString()} / ${city.polygons.length.toLocaleString()}`;
    }

    function rebuildCity(): void {
      if (cityRebuildTimer) {
        clearTimeout(cityRebuildTimer);
        cityRebuildTimer = null;
      }
      const phase = city.spanY > 0 ? positiveMod(-cameraY, city.spanY) / city.spanY : 0;
      const next = createCityState(buildCity(cityConfig));
      cameraY = -phase * next.spanY;
      camera.target = toWorld(0, cameraY, 0);
      recycleRows(next);
      computeBackfaces(next);
      refreshRowVisibility(true, next);
      city = next;
      cityMesh.setPolygons(city.polygons);
      rainSeedByLane.clear();
      rainStepByLane.clear();
      resetGlyphTravel();
      updateCityReadouts();
      resetAnimationClock = true;
      forceCull = false;
      dirty = false;
      rebuildRevision++;
    }

    function scheduleCityRebuild(delay = 110): void {
      if (cityRebuildTimer) clearTimeout(cityRebuildTimer);
      cityRebuildTimer = setTimeout(rebuildCity, delay);
    }

    function bindCityRange(
      input: HTMLInputElement | null,
      readout: HTMLElement | null,
      update: (value: number) => string,
    ): void {
      if (!input) return;
      input.addEventListener("input", () => {
        const display = update(Number(input.value));
        if (readout) readout.textContent = display;
        scheduleCityRebuild();
      });
      input.addEventListener("change", () => scheduleCityRebuild(0));
    }

    bindCityRange(depthBlocksInput, depthBlocksValue, (value) => {
      cityConfig.depthBlocks = Math.round(value);
      return cityConfig.depthBlocks.toFixed(0);
    });
    bindCityRange(runBlocksInput, runBlocksValue, (value) => {
      cityConfig.runBlocks = Math.round(value);
      return cityConfig.runBlocks.toFixed(0);
    });
    bindCityRange(blockDepthInput, blockDepthValue, (value) => {
