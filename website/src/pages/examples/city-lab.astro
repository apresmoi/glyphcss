---
import ExampleLayout from "../../layouts/ExampleLayout.astro";
import { CityLabExample } from "../../components/CityLabExample";
const title = "glyphcss · Endless ASCII City";
const description =
  "A procedural endless city rendered as colored ASCII with a performance-first glyphcss animation loop.";
---

<ExampleLayout
  title={title}
  description={description}
  path="/examples/city-lab/"
  image="/og/city-lab.png"
  active="city-lab"><CityLabExample client:load /></ExampleLayout
>
