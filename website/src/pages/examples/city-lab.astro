    const cityQuerySync = createExampleQuerySync(() => ({
      rotX: tiltPlaying && rotationAxis === "x" ? rotationOrigin : camera.rotX,
      rotY: normalizeDegrees(tiltPlaying && rotationAxis === "y" ? rotationOrigin : camera.rotY),
