---
import ExampleLayout from "../../layouts/ExampleLayout.astro";
import { FlatmapExample } from "../../components/FlatmapExample";
const title = "glyphcss · ASCII Iso World Map";
const description =
  "The whole planet flattened into a tiled isometric glyph map — ETOPO1 topography rasterised to colored ASCII, drag to pan and zoom.";
---

<ExampleLayout
  title={title}
  description={description}
  path="/examples/flatmap/"
  image="/og/flatmap.png"
  active="flatmap"><FlatmapExample client:load /></ExampleLayout
>
