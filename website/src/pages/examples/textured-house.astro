---
import ExamplesSidebar from "../../components/ExamplesSidebar.astro";
import DocsHeader from "../../components/DocsHeader.astro";
import BaseHead from "../../components/BaseHead.astro";

const title = "glyphcss · Textured House";
const description = "Walk through a human-scale textured cottage rendered in PolyCSS from its baked SDXL texture atlas.";
---

<html lang="en">
<head>
  <BaseHead title={title} description={description} path="/examples/textured-house/" />
  <style>
    html, body { background: #090b0d; color: #f6e8cb; margin: 0; min-height: 100vh; font-family: ui-monospace, "JetBrains Mono", "SF Mono", monospace; }
    body { display: flex; overflow: hidden; }
    .ex-layout { position: fixed; inset: var(--sl-nav-height, 72px) 0 0; display: flex; min-width: 0; }
    .ex-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .map-shell { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .map-head { padding: 24px 32px 12px; border-bottom: 1px solid rgba(255, 232, 184, 0.14); }
    .map-head h1 { margin: 0; font-size: 22px; color: rgba(255, 245, 225, 0.94); font-weight: 600; letter-spacing: 0.04em; }
    .map-head p { max-width: 1040px; margin: 6px 0 0; font-size: 13px; color: rgba(238, 218, 185, 0.62); }
    .map-stage { flex: 1; min-height: 0; position: relative; }
    .house-host {
      position: absolute; inset: 0; overflow: hidden; touch-action: none;
      background:
        radial-gradient(circle at 50% 69%, rgba(230, 194, 135, 0.14), transparent 38%),
        linear-gradient(#1b2431 0%, #52697d 42%, #3b4b3a 49%, #1d281e 100%);
    }
    .house-host.is-hazy {
      background:
        radial-gradient(circle at 50% 60%, rgba(222, 230, 203, 0.12), transparent 48%),
        linear-gradient(#27313b 0%, #70808a 43%, #4d5942 50%, #273023 100%);
    }
    .house-host::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(transparent 70%, rgba(0,0,0,0.25));
    }
    .house-host .polycss-camera, .house-host .polycss-scene { pointer-events: none; }
    .house-host.is-ready { cursor: crosshair; }
    .iso-controls {
      position: absolute; top: 14px; right: 14px; z-index: 10; width: 230px; padding: 12px 14px;
      background: rgba(8, 12, 18, 0.86); backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 232, 184, 0.2); font-size: 11px; color: rgba(255, 232, 184, 0.7);
    }
    .iso-controls h2 { margin: 0 0 10px; font-size: 11px; letter-spacing: 0.08em; color: rgba(56, 189, 248, 0.95); font-weight: 600; }
    .iso-ctl { padding: 10px 0; border-top: 1px solid rgba(255,232,184,0.1); }
    .iso-ctl:first-of-type { border-top: 0; padding-top: 0; }
    .iso-ctl-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: rgba(255,232,184,0.78); }
    .iso-seg, .env-seg { display: flex; gap: 4px; margin-top: 7px; }
    .iso-seg button, .env-seg button {
      flex: 1; padding: 5px 4px; font: inherit; font-size: 10px;
      background: transparent; color: rgba(255,232,184,0.55);
      border: 1px solid rgba(255,232,184,0.2); cursor: pointer;
    }
    .iso-seg button.active, .env-seg button.active {
      color: rgba(255,232,184,0.98); border-color: rgba(56,189,248,0.6); background: rgba(56,189,248,0.08);
    }
    .legend { display: flex; flex-wrap: wrap; gap: 5px 8px; margin-top: 7px; color: rgba(255,232,184,0.56); }
    .key {
      display: inline-flex; min-width: 16px; min-height: 16px; align-items: center; justify-content: center;
      padding: 0 3px; border: 1px solid rgba(255,232,184,0.26); border-radius: 3px;
      background: rgba(255,232,184,0.06); color: rgba(255,232,184,0.88); font: 600 9px/1 ui-monospace, "JetBrains Mono", monospace;
    }
    .status { margin-top: 7px; color: rgba(133, 213, 255, 0.82); line-height: 1.45; }
    .reset {
      width: 100%; margin-top: 9px; padding: 8px 10px; cursor: pointer;
      color: rgba(255,232,184,0.9); background: rgba(255,232,184,0.07);
      border: 1px solid rgba(255,232,184,0.22); font: 600 11px/1 ui-monospace, "JetBrains Mono", monospace;
    }
    .reset:hover { border-color: rgba(56,189,248,0.8); color: #fff; }
    .origin-note { margin: 0; color: rgba(255,232,184,0.46); font-size: 10px; line-height: 1.45; }
    .fpv-hint { display: none; }
    body.house-fpv .fpv-hint { display: flex; }
    .fpv-hint .locked, .fpv-hint .unlocked { display: none; }
    body.house-fpv .fpv-hint .unlocked { display: inline-flex; }
    body.house-fpv.house-locked .fpv-hint .unlocked { display: none; }
    body.house-fpv.house-locked .fpv-hint .locked { display: inline-flex; }
    @media (max-width: 50rem), (max-height: 34rem) {
      .map-head { display: none; }
      .iso-controls { width: auto; left: 10px; right: 10px; top: auto; bottom: 10px; }
      .iso-ctl:nth-of-type(2) { display: none; }
    }
    @media (max-height: 34rem) {
      :global(body > .header), :global(.ex-sidebar) { display: none; }
      .ex-layout { top: 0; }
    }
  </style>
</head>
<body>
  <DocsHeader />
  <div class="ex-layout">
    <ExamplesSidebar active="textured-house" />
    <div class="ex-main">
      <div class="map-shell">
        <header class="map-head">
          <h1>[ TEXTURED CABIN · MESH → ATLAS → POLYCSS ]</h1>
          <p>A 24 × 18 m authored cabin — 209 architectural faces, compacted by PolyCSS to 194 texture-preserving render surfaces, not a field of boxes, so a whole wall is one quad that claims one large atlas chart. Textured once with SDXL over 38 whole-scene views followed by 8 close-up refinement passes, then baked into a static 4096² atlas. This page loads only that OBJ and atlas into PolyCSS — no diffusion model or GPU is in the render loop. Click to enter at the path; WASD to walk, Esc for the overview.</p>
        </header>
        <div class="map-stage">
          <div class="house-host" id="house-host" aria-label="First-person textured house"></div>
          <aside class="iso-controls" aria-label="Textured house controls">
            <h2>[ COTTAGE WALKTHROUGH ]</h2>
            <div class="iso-ctl">
              <div class="iso-ctl-row"><span>camera</span><span>PolyCSS</span></div>
              <div class="iso-seg" aria-label="Camera flow">
                <button type="button" class="active" disabled>establishing</button>
                <button type="button" disabled>click → walk</button>
              </div>
              <div class="legend">
                <span><kbd class="key">click</kbd> enter at the path</span>
                <span class="fpv-hint unlocked"><kbd class="key">click</kbd> look</span>
                <span class="fpv-hint locked"><kbd class="key">Esc</kbd> release</span>
              </div>
              <div class="legend fpv-hint">
                <span><kbd class="key">W</kbd><kbd class="key">A</kbd><kbd class="key">S</kbd><kbd class="key">D</kbd> walk</span>
                <span><kbd class="key">Esc</kbd> overview</span>
              </div>
            </div>
            <div class="iso-ctl">
              <div class="iso-ctl-row"><span>environment</span><span>horizon</span></div>
              <div class="env-seg" id="environment-seg">
                <button type="button" class="active" data-environment="clear">clear</button>
                <button type="button" data-environment="haze">soft haze</button>
              </div>
            </div>
            <div class="iso-ctl">
              <div class="iso-ctl-row"><span>render path</span><span>OBJ + packed UV atlas</span></div>
              <div class="status" id="house-status">loading mesh and baked atlas…</div>
            </div>
            <div class="iso-ctl">
              <p class="origin-note">A 1.7 m eye stands on the lawn at z&nbsp;=&nbsp;0.06. The cottage and its atlas are static; only PolyCSS’s camera transform changes while you walk.</p>
              <button class="reset" id="reset-house" type="button">[ Return to establishing view ]</button>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>

  <script>
    import {
      createPolyFirstPersonControls,
      createPolyPerspectiveCamera,
      createPolyScene,
      parseObj,
      type Polygon,
    } from "@layoutit/polycss";

    const HOUSE_OBJ = "/examples/textured-house/cabin.obj";
    const HOUSE_ATLAS = "/examples/textured-house/cabin-texture.png";
    // Metric source mesh: a person standing on the lawn at z=0.06 has a
    // 1.7 m eye at z=1.76. Spawn just south of the path, facing the cottage.
    const START: [number, number, number] = [0, -16, 1.76];
    // RotX=90 is level in PolyCSS.  A shallow 14° establishing pitch leaves
    // actual sky above the far edge of the lawn instead of filling the frame
    // with the ground plane.
    const LOOK = { rotX: 76, rotY: 20 };
    // At level pitch PolyCSS derives forward as [-cos(rotY), -sin(rotY), 0].
    // The cottage is north (+Y) of START, so 270° is deliberately northward.
    const FPV_LOOK = { rotX: 90, rotY: 270 };
    // 32 px/m keeps a 2.1 m wall at the 4.5 m path setback human-scale with
    // the scene's 900 px perspective, rather than turning the near lawn into
    // an oversized foreground sheet.
    const FPV_ZOOM = 32;

    const groundQuad = (minX: number, minY: number, maxX: number, maxY: number, color: string): Polygon => ({
      // CCW from above: the lawn's normal points toward +Z. These deliberately
      // have no texture / UV fields — giving this geometry the packed house UV
      // atlas would sample unrelated cells and turn the horizon into noise.
      vertices: [[minX, minY, 0], [maxX, minY, 0], [maxX, maxY, 0], [minX, maxY, 0]],
      color,
    });

    // A four-piece ring meets the existing 20 × 14 m plot exactly but never
    // overlaps it, avoiding z-fighting with the authored lawn tiles at z=0.06.
    // It stretches far beyond the camera's fitted view and the walking range,
    // closing the old floating-object void without putting the terrain in the
    // SDXL atlas.
    // Sized to the CABIN's own footprint (x -12.1..12.1, y -9.1..9.1), not the
    // retired 20x14 grid. Kept deliberately modest: PolyCSS gives each polygon a
    // DOM element sized worldSize * zoom, so a 340 m quad became a ~10,000 px
    // layer and destroyed the frame rate. The CSS gradient carries the far
    // distance; this geometry only has to close the ground plane near the eye.
    // Must match the AUTHORED GROUND PLANE exactly, not the mesh's overall
    // bounds -- fence posts overhang the lawn, so using the full extent left a
    // 10 cm slot of empty space visible right around the plot edge.
    const PLOT = { minX: -12, maxX: 12, minY: -9, maxY: 9 };
    const REACH = 34;
    const horizonGround: Polygon[] = [
      groundQuad(PLOT.minX - REACH, PLOT.minY - REACH, PLOT.maxX + REACH, PLOT.minY, "#6f8b57"),
      groundQuad(PLOT.minX - REACH, PLOT.maxY, PLOT.maxX + REACH, PLOT.maxY + REACH, "#668250"),
      groundQuad(PLOT.minX - REACH, PLOT.minY, PLOT.minX, PLOT.maxY, "#77945e"),
      groundQuad(PLOT.maxX, PLOT.minY, PLOT.maxX + REACH, PLOT.maxY, "#668250"),
    ];

    async function mountHouse(): Promise<void> {
      const host = document.getElementById("house-host") as HTMLDivElement | null;
      const status = document.getElementById("house-status");
      const reset = document.getElementById("reset-house") as HTMLButtonElement | null;
      if (!host || !status) return;

      try {
        const response = await fetch(HOUSE_OBJ);
        if (!response.ok) throw new Error(`OBJ request failed (${response.status})`);
        const obj = await response.text();
        const materials = [...new Set([...obj.matchAll(/^usemtl\s+(\S+)/gm)].map((match) => match[1]!))];
        if (!materials.length) throw new Error("The house OBJ has no materials to texture");

        const parsed = parseObj(obj, {
          targetSize: 20,
          materialTextures: Object.fromEntries(materials.map((material) => [material, HOUSE_ATLAS])),
        });
        // PolyCSS's OBJ loader converts +Y-up files into its +Z-up world. The
        // glyph exporter is already +Z-up, so invert only that documented axis
        // remap while preserving the parser's UV triangles and material texture.
        // The glyph exporter's atlas puts v=0 at the TOP of the image (texel
        // row = floor(v * size)), while PolyCSS samples with the standard OBJ
        // convention (v=0 at the bottom). Flip V so each face samples its own
        // packed atlas cell instead of the vertically mirrored one.
        const polygons: Polygon[] = parsed.polygons.map((polygon) => ({
          ...polygon,
          vertices: polygon.vertices.map(([x, y, z]): [number, number, number] => [y, z, x]),
          uvs: polygon.uvs?.map(([u, v]): [number, number] => [u, 1 - v]),
        }));
        if (!polygons.length || polygons.some((polygon) => !polygon.texture || !polygon.uvs)) {
          throw new Error("The packed OBJ UV atlas did not survive PolyCSS parsing");
        }

        // Fit the mesh to the host the same way the spray views fit it to their
        // 256x128 grid: project the vertices through the view rotation and scale
        // so the silhouette fills ~85% of the shorter axis. Hardcoding a zoom
        // breaks the moment the viewport or the mesh extent changes.
        const bounds = polygons.reduce(
          (acc, polygon) => {
            for (const vertex of polygon.vertices) {
              for (let axis = 0; axis < 3; axis++) {
                acc.min[axis] = Math.min(acc.min[axis], vertex[axis]);
                acc.max[axis] = Math.max(acc.max[axis], vertex[axis]);
              }
            }
            return acc;
          },
          { min: [Infinity, Infinity, Infinity], max: [-Infinity, -Infinity, -Infinity] },
        );
        const centroid: [number, number, number] = [0, 1, 2].map(
          (axis) => (bounds.min[axis] + bounds.max[axis]) / 2,
        ) as [number, number, number];

        const fitZoom = (rotX: number, rotY: number): number => {
          const rx = (rotX * Math.PI) / 180, ry = (rotY * Math.PI) / 180;
          let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
          for (const polygon of polygons) for (const vertex of polygon.vertices) {
            const x = vertex[0] - centroid[0], y = vertex[1] - centroid[1], z = vertex[2] - centroid[2];
            const px = x * Math.cos(ry) - y * Math.sin(ry);
            const py = (x * Math.sin(ry) + y * Math.cos(ry)) * Math.cos(rx) - z * Math.sin(rx);
            minX = Math.min(minX, px); maxX = Math.max(maxX, px);
            minY = Math.min(minY, py); maxY = Math.max(maxY, py);
          }
          const rect = host.getBoundingClientRect();
          const shorter = Math.max(320, Math.min(rect.width, rect.height));
          // Keep breathing room around the cottage: at the low establishing
          // pitch this preserves both the far, geometric lawn horizon and sky.
          return (0.76 * shorter) / Math.max(maxX - minX, maxY - minY, 1e-6);
        };

        const camera = createPolyPerspectiveCamera({
          ...LOOK,
          zoom: fitZoom(LOOK.rotX, LOOK.rotY),
          perspective: 900,
          target: centroid,
        });
        const scene = createPolyScene(host, {
          camera,
          autoCenter: true,
          textureBackend: "atlas",
          textureLighting: "dynamic",
          // The 4095 × 1120 atlas already hits PolyCSS's 4096-px packing edge.
          // Lower quality keeps that page and its DOM leaves, while reducing
          // texel density, so it buys no measured layer-cost reduction here.
          textureQuality: 1,
          seamBleed: 0,
          textureImageRendering: "pixelated",
          directionalLight: { direction: [-0.4, -0.55, 0.72], intensity: 0, color: "#ffffff" },
          ambientLight: { intensity: 1, color: "#ffffff" },
        });
        // The OBJ parser fan-triangulates quads. Its textured merge keeps each
        // original texture triangle (and its UVs), collapsing only coplanar
        // surfaces without changing the packed-atlas mapping.
        scene.add({ ...parsed, polygons }, { id: "authored-textured-house", merge: true, meshResolution: "lossless" });
        // scene.add takes a ParseResult, not a bare polygon list; passing the
        // array directly throws "Invalid value used as weak map key".
        scene.add({ polygons: horizonGround }, {
          id: "untextured-horizon-lawn",
          meshResolution: "lossless",
          // The house stays the establish-view pivot; this terrain only closes
          // the world around it and must not widen the fitted subject bounds.
          excludeFromAutoCenter: true,
        });

        const fpv = createPolyFirstPersonControls(scene, {
          moveSpeed: 9,
          eyeHeight: 1.7,
          groundZ: 0.06,
          jumpEnabled: false,
          crouchEnabled: false,
          minPitch: 35,
          maxPitch: 145,
        });
        // Keep the fitted establishing view until a viewer clicks into the
        // first-person walkthrough. Esc returns here through pointerlockchange.
        let walking = false;

        // Share a standing spot by URL: #w=x,y,pitch,yaw (metres and degrees,
        // two decimals). Quantising means an idle viewer re-encodes the same
        // string, so the replaceState below no-ops instead of spamming history.
        const round = (value: number): string => (Math.round(value * 100) / 100).toString();
        const writeHash = (): void => {
          const [x, y] = fpv.getOrigin();
          // Read the live camera rather than a mirrored copy: mouselook mutates
          // camera.state directly, so a cached angle can silently drift.
          const hash = walking
            ? `#w=${round(x)},${round(y)},${round(camera.state.rotX)},${round(camera.state.rotY)}`
            : "";
          if (hash !== location.hash) history.replaceState(null, "", `${location.pathname}${location.search}${hash}`);
        };
        const readHash = (): { x: number; y: number; rotX: number; rotY: number } | null => {
          const raw = location.hash.startsWith("#w=") ? location.hash.slice(3) : "";
          const parts = raw.split(",").map(Number);
          if (parts.length !== 4 || parts.some((value) => !Number.isFinite(value))) return null;
          return { x: parts[0]!, y: parts[1]!, rotX: parts[2]!, rotY: parts[3]! };
        };

        let lastHashWrite = 0;
        fpv.addEventListener("change", () => {
          if (!walking) return;
          const now = performance.now();
          if (now - lastHashWrite < 400) return;
          lastHashWrite = now;
          writeHash();
        });

        const enterWalk = (at: { x: number; y: number; rotX: number; rotY: number }): void => {
          // Look angles MUST be applied before setOrigin: setOrigin re-derives the
          // scene target from the CURRENT camera rotation, so restoring position
          // first would point a URL-loaded view in the wrong direction.
          camera.update({ rotX: at.rotX, rotY: at.rotY, zoom: FPV_ZOOM });
          fpv.resume();
          fpv.setOrigin([at.x, at.y, START[2]]);
          walking = true;
          document.body.classList.add("house-fpv");
        };

        // Capture the incoming link BEFORE resetView runs: resetView writes the
        // hash (clearing it, since it leaves walk mode), which would erase the
        // very state we are trying to restore.
        const shared = readHash();

        const resetView = (): void => {
          walking = false;
          fpv.pause();
          camera.update({ ...LOOK, zoom: fitZoom(LOOK.rotX, LOOK.rotY), target: centroid });
          scene.applyCamera();
          document.body.classList.remove("house-fpv", "house-locked");
          writeHash();
        };
        resetView();
        reset?.addEventListener("click", resetView);

        // A shared link lands directly in the walkthrough at that spot.
        if (shared) { enterWalk(shared); writeHash(); }
        // Entering the walkthrough teleports to the path ONCE. Re-clicking after
        // Esc must only re-acquire the pointer lock — re-running setOrigin there
        // would snap the viewer back to the spawn every time they re-grab the
        // mouse, which reads as the camera "resetting itself".
        host.addEventListener("click", () => {
          if (!walking) {
            // The fitted camera looks down from above; a walk starts level and
            // northward along the path.
            enterWalk({ x: START[0], y: START[1], rotX: FPV_LOOK.rotX, rotY: FPV_LOOK.rotY });
            writeHash();
          }
          // pause() intentionally removes PolyCSS's own click listener while
          // the overview is showing. Request the lock after resuming so this
          // very click enters the walkthrough instead of requiring a second.
          try { fpv.lock(); } catch { /* pointer lock may be unavailable */ }
        });
        // Releasing the pointer must NOT move the camera — matching the Parthenon
        // example, Esc only releases mouselook and leaves you standing where you
        // were. Returning to the overview is an explicit button press.
        document.addEventListener("pointerlockchange", () => {
          document.body.classList.toggle("house-locked", document.pointerLockElement === host);
        });
        document.getElementById("environment-seg")?.addEventListener("click", (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-environment]");
          if (!button) return;
          const hazy = button.dataset.environment === "haze";
          host.classList.toggle("is-hazy", hazy);
          button.parentElement?.querySelectorAll("button").forEach((item) => item.classList.toggle("active", item === button));
        });
        host.classList.add("is-ready");
        status.textContent = `${polygons.length.toLocaleString()} UV-mapped triangles · 1 static SDXL atlas · no diffusion`;
        (window as unknown as { __texturedHouse?: unknown }).__texturedHouse = { scene, camera, fpv, polygons };
      } catch (error) {
        status.textContent = `Unable to load the static house: ${error instanceof Error ? error.message : String(error)}`;
      }
    }

    mountHouse();
  </script>
</body>
</html>
