---
import BaseHead from '../components/BaseHead.astro';
import DocsHeader from '../components/DocsHeader.astro';
import GenerativeWorkbench from '../components/GenerativeWorkbench/GenerativeWorkbench.tsx';

const title = 'Generative image designer — glyphcss';
const description = 'A retrieved-base image-synthesis workbench with aligned glyphcss controls and an explicit browser residual refiner.';
---
<html lang="en">
  <head><BaseHead title={title} description={description} path="/generative/" /></head>
  <body>
    <DocsHeader />
    <GenerativeWorkbench client:only="react" />
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    @media (max-width: 38rem) {
      :global(:root) { --sl-nav-height: 90px; }
    }
    :global(html, body) {
      margin: 0;
      min-height: 100vh;
      overflow: hidden;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
  </style>
</html>
