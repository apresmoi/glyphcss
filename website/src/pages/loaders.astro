---
import LoadersWorkbench from '../components/LoadersWorkbench/LoadersWorkbench.tsx';
import DocsHeader from '../components/DocsHeader.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/glyph-demo.css';

const title = 'Loaders — animated ASCII spinners and progress fields | glyphcss';
const description = 'A gallery of looping ASCII loaders built from glyphcss effects on a flat plane, each shown at nine different box sizes so you can see how the pattern reads at every aspect ratio.';
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path="/loaders/" />
  </head>
  <body>
    <div class="page">
      <DocsHeader />
      <div class="debug-page-shell">
        <LoadersWorkbench client:only="react" />
      </div>
    </div>
  </body>
  <style>
    :global(:root) { --sl-nav-height: 72px; }
    /* The floating search dock overlays the top-left of the content area; this
       page puts real text there (unlike /gallery and /synth, whose viewport is
       full-bleed render). Same treatment /wordart uses. */
    :global(.sidebar-search-dock) { display: none !important; }
    @media (max-width: 38rem) {
      :global(:root) { --sl-nav-height: 90px; }
    }
    :global(html, body) {
      margin: 0;
      background: #07090d;
      color: rgba(255, 232, 184, 0.94);
      font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Menlo", monospace;
    }
    :global(body) { min-height: 100vh; overflow: hidden; }
    /* Same shell /wordart uses: park the page below the fixed site header so
       the stage heading isn't overlapped by it. */
    .debug-page-shell { position: fixed; inset: var(--sl-nav-height) 0 0; min-width: 0; min-height: 0; }
  </style>
</html>
