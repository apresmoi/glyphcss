---
import WorkbenchLayout from "../layouts/WorkbenchLayout.astro";
import { WordArtWorkbench } from "../components/WordArtWorkbench";
const title = "WordArt — 3D ASCII text from any font | glyphcss";
const description =
  "Extrude any Google font into 3D text — gradients, block textures, bevels, warps — rasterised to ASCII in a single <pre>. Powered by glyphcss + @glyphcss/fonts.";
---

<WorkbenchLayout title={title} description={description} path="/wordart/" image="/og/wordart.png">
  <WordArtWorkbench client:only="react" />
</WorkbenchLayout>
