---
import ContentLayout from "../layouts/ContentLayout.astro";
import { HomePage } from "../components/HomePage";
import { GlyphDemo } from "../components/GlyphDemo";
import { HomeAsciiArt } from "../components/HomeAsciiArt";
import { FrameworkTabs } from "../components/FrameworkTabs";
import { PackageVersion } from "../components/PackageVersion";
import { GitHubStars } from "../components/GitHubStars";
import GlyphRender from "../integrations/astro/GlyphRender.astro";
import { title, description, ldJson, frameworkTabs } from "../features/home/content";
import { homeDiagrams } from "../features/home/diagrams";
---

<ContentLayout title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldJson)} />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css"
  />
  <HomePage>
    <GlyphDemo
      client:load
      slot="hero"
      id="hero-demo"
      embedded
      polygonsUrl="/data/landing-earth.json"
      defaults={JSON.stringify({ rotX: 103, rotY: 45, duration: 12, renderMode: "solid", density: 1 })}
      noCode
      noControls
      autoRotate
      invertDrag
      pitchRange={null}
      noZoom
      interactiveDownscale={1}
      realSunLight
      light={JSON.stringify({ intensity: 1.1, ambient: 0.45 })}
    />
    <HomeAsciiArt client:load slot="rule" factory="heroRule" className="hero-rule" ariaLabel="divider" />
    <div slot="diagram" class="home-diagrams">
      {
        homeDiagrams.map(({ layout, input }) => (
          <div class={`home-diagram-${layout}`}>
            <GlyphRender
              {...input}
              showSource={false}
              caption="Each render writes the text once per <pre>. Optional hotspots share the scene camera."
            />
          </div>
        ))
      }
    </div>
    <FrameworkTabs slot="frameworks" tabs={frameworkTabs} client:load />
    <PackageVersion slot="version" client:load />
    <GitHubStars slot="stars" client:visible />
  </HomePage>
</ContentLayout>
