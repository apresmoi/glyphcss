---
import styles from "./GlyphRender.module.css";
import {
  normalizeGlyphDocsSource,
  renderGlyphDocs,
  type GlyphDocsRenderInput,
} from "../../services/docs-render/glyphRender";

type Props = GlyphDocsRenderInput & { showSource?: boolean };
const { showSource = true, ...input } = Astro.props;
const result = await renderGlyphDocs(input);
const source =
  typeof input.source === "string" ? normalizeGlyphDocsSource(input.source) : JSON.stringify(input.source, null, 2);
---

<figure class={styles.root} data-glyph-render={JSON.stringify(input)} aria-label="Rendered example">
  {
    result.html ? (
      <pre class="glyph-docs-output" set:html={result.html} />
    ) : (
      <pre class="glyph-docs-output">{result.text}</pre>
    )
  }
  {
    showSource && (
      <details>
        <summary>Source</summary>
        <pre class="glyph-docs-source" set:text={source} />
      </details>
    )
  }
  {
    result.report.ledger.length > 0 && (
      <details>
        <>
          <summary>Render notes</summary>
          <ul>
            {result.report.ledger.map((entry) => (
              <li>
                <code>{entry.code}</code>: {entry.message}
              </li>
            ))}
          </ul>
        </>
      </details>
    )
  }
</figure>
