---
interface Props {
  active: "world" | "flatmap" | "image";
}
const { active } = Astro.props;

const items = [
  { id: "world", label: "World", href: "/examples/world/", desc: "Globe · ETOPO1" },
  { id: "flatmap", label: "Flat Map", href: "/examples/flatmap/", desc: "Iso · Web Mercator" },
  { id: "image", label: "Image", href: "/examples/image/", desc: "Drop a photo · ASCII" },
] as const;
---

<aside class="ex-sidebar">
  <div class="ex-sb-title">EXAMPLES</div>
  <nav class="ex-sb-nav">
    {items.map((it) => (
      <a
        class:list={["ex-sb-link", { "is-active": it.id === active }]}
        href={it.href}
        data-example-id={it.id}
        aria-current={it.id === active ? "page" : undefined}
      >
        <span class="ex-sb-label">{it.label}</span>
        <span class="ex-sb-desc">{it.desc}</span>
      </a>
    ))}
  </nav>
</aside>

<script>
  // Prevent re-navigation when clicking the already-active sidebar item.
  // Without this, clicking "World" while on /examples/world/ navigates to
  // /examples/world (no trailing slash), causing a full reload.
  // Mirrors voxcss's tv-tile selectTile guard: `if (preset.id === activePreset.id) return`.
  document.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>("a.ex-sb-link");
    if (!link) return;
    if (link.getAttribute("aria-current") === "page") {
      e.preventDefault();
    }
  });
</script>

<style>
  /* The examples are full-screen apps under the fixed site header, which owns
     the brand + section nav. Hide Starlight's floating search dock so it doesn't
     overlap this sub-nav (mirrors the WordArt page). */
  :global(.sidebar-search-dock) { display: none !important; }
  .ex-sidebar {
    width: 220px;
    flex-shrink: 0;
    background: #06080d;
    border-right: 1px solid rgba(255, 232, 184, 0.12);
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", monospace;
  }
  .ex-sb-title {
    padding: 0 20px 8px;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(255, 232, 184, 0.4);
  }
  .ex-sb-nav { display: flex; flex-direction: column; }
  .ex-sb-link {
    display: flex;
    flex-direction: column;
    padding: 9px 20px;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .ex-sb-link:hover { background: rgba(255, 232, 184, 0.04); }
  .ex-sb-link.is-active {
    border-left-color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }
  .ex-sb-label { font-size: 13px; color: rgba(255, 232, 184, 0.9); }
  .ex-sb-link.is-active .ex-sb-label { color: #fff; }
  .ex-sb-desc { font-size: 10px; color: rgba(255, 232, 184, 0.4); margin-top: 1px; }

  /* Mobile: stack the canvas below a horizontal tab bar instead of a 220px
     side rail that would squash the render into a sliver. */
  @media (max-width: 50rem) {
    :global(.ex-layout) { flex-direction: column; }
    :global(.ex-main) { min-height: 0; }
    .ex-sidebar {
      width: 100%;
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding: 0;
      border-right: none;
      border-bottom: 1px solid rgba(255, 232, 184, 0.12);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .ex-sidebar::-webkit-scrollbar { display: none; }
    .ex-sb-title { display: none; }
    .ex-sb-nav { flex-direction: row; flex: 1; }
    .ex-sb-link {
      flex: 1;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px 12px;
      border-left: none;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .ex-sb-link.is-active { border-bottom-color: #38bdf8; }
    .ex-sb-desc { display: none; }
  }
</style>
