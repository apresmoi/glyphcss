{
  "name": "@glyphcss/ascii-image-generation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:native-reference": "python3 -m unittest tests/test_freeze_native_reference.py",
    "check:native-reference-review": "python3 scripts/check-native-reference-review.py",
    "freeze:native-reference": "bash scripts/run-native-reference-freeze.sh",
    "smoke:native-training": "bash scripts/run-native-training-feasibility.sh",
    "test:overfit-readiness": "python3 -m unittest tests/test_overfit_readiness.py tests/test_model_raster.py tests/test_sdxl_controlnet.py",
    "validate:overfit-report": "node scripts/validate-overfit-report.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/test-browser.mjs",
    "test:reprojection": "node scripts/test-browser.mjs -- reprojection",
    "validate:schema": "node scripts/validate-manifest.mjs --fixtures",
    "validate:tensor": "node scripts/validate-tensor.mjs",
    "glyph-confusion": "node scripts/glyph-confusion.mjs",
    "evaluate": "sh scripts/evaluate.sh",
    "generate:controls": "node scripts/generate-controls.mjs",
    "generate:targets": "node src/generate-targets.mjs",
    "pilot:dry-run": "node src/pilot-preflight.mjs --dry-run",
    "validate:pilot": "sh scripts/validate-dataset.sh",
    "build:evidence": "node scripts/build-evidence.mjs",
    "build:ovens": "node scripts/build-oven-payloads.mjs --fixtures",
    "check:ovens": "node scripts/check-ovens.mjs",
    "coarse:serve": "node scripts/serve-coarse-bases.mjs",
    "train:coarse-refiner": "node scripts/train-coarse-refiner.mjs --check",
    "validate:coarse": "node scripts/validate-coarse-slice.mjs --check",
    "reproduce": "node scripts/unimplemented-command.mjs reproduce"
  },
  "devDependencies": {
    "@glyphcss/compile": "workspace:^",
    "@glyphcss/core": "workspace:^",
    "@napi-rs/canvas": "1.0.2",
    "@types/node": "20.19.43",
    "ajv": "8.17.1",
    "glyphcss": "workspace:^",
    "typescript": "5.9.3",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
