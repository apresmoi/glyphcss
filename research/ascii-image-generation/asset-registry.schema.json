{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/asset-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "registryId", "config", "evidenceSources", "stats", "textures", "assets", "sourceFiles", "splitGroups", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-asset-registry/v1" },
    "generatorVersion": { "const": "glyph-asset-registry-builder/v1" },
    "registryId": { "$ref": "#/$defs/id" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "research/ascii-image-generation/config/asset-registry.json" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "evidenceSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSource" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannedMeshFiles", "appearanceSourceFiles", "primaryAppearanceSourceFiles", "usableTextureUvSourceFiles", "canonicalAssets", "aliasPaths", "exactRgbCanonicalAssets", "materialOnlyCanonicalAssets", "blockedCanonicalAssets", "admittedCanonicalAssets", "admittedExactRgbCanonicalAssets", "admittedMaterialOnlyCanonicalAssets", "localResearchOnlyCanonicalAssets", "splitGroups"],
      "properties": {
        "scannedMeshFiles": { "type": "integer", "minimum": 1 },
        "appearanceSourceFiles": { "type": "integer", "minimum": 1 },
        "primaryAppearanceSourceFiles": { "type": "integer", "minimum": 1 },
        "usableTextureUvSourceFiles": { "type": "integer", "minimum": 0 },
        "canonicalAssets": { "type": "integer", "minimum": 1 },
        "aliasPaths": { "type": "integer", "minimum": 0 },
        "exactRgbCanonicalAssets": { "type": "integer", "minimum": 0 },
        "materialOnlyCanonicalAssets": { "type": "integer", "minimum": 0 },
        "blockedCanonicalAssets": { "type": "integer", "minimum": 0 },
        "admittedCanonicalAssets": { "type": "integer", "minimum": 0 },
        "admittedExactRgbCanonicalAssets": { "type": "integer", "minimum": 0 },
        "admittedMaterialOnlyCanonicalAssets": { "type": "integer", "minimum": 0 },
        "localResearchOnlyCanonicalAssets": { "type": "integer", "minimum": 0 },
        "splitGroups": { "type": "integer", "minimum": 1 }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "mimeType", "byteLength", "locations"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/hash" },
          "mimeType": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 1 },
          "locations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalPath", "aliases", "geometry", "sourcePackIds", "sourceIds", "label", "classHints", "uv", "materials", "textureIds", "appearanceDisposition", "bindingIssues", "provenanceDisposition", "provenanceEvidence", "admitted", "admissionScope", "admissionReasons", "splitGroupId", "split"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "canonicalPath": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "sha256", "byteLength"],
            "properties": {
              "format": { "enum": ["obj", "gltf", "glb"] },
              "sha256": { "$ref": "#/$defs/hash" },
              "byteLength": { "type": "integer", "minimum": 1 }
            }
          },
          "sourcePackIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "label": { "type": "string", "minLength": 1 },
          "classHints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "uv": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "coordinateCount", "texturedPrimitiveCount", "primitiveCount"],
            "properties": {
              "status": { "enum": ["none", "partial", "all"] },
              "coordinateCount": { "type": "integer", "minimum": 0 },
              "texturedPrimitiveCount": { "type": "integer", "minimum": 0 },
              "primitiveCount": { "type": "integer", "minimum": 0 }
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "baseColor", "textures"],
              "properties": {
                "name": { "type": "string" },
                "baseColor": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "number" } }
                  ]
                },
                "textures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["role", "textureId"],
                    "properties": {
                      "role": { "enum": ["baseColor", "metallicRoughness", "normal", "occlusion", "emissive"] },
                      "textureId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
                    }
                  }
                }
              }
            }
          },
          "textureIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "appearanceDisposition": { "enum": ["exact-rgb", "material-only", "blocked"] },
          "bindingIssues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "provenanceDisposition": { "enum": ["verified", "attribution-only", "unverified", "blocked"] },
          "provenanceEvidence": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
          "admitted": { "type": "boolean" },
          "admissionScope": { "anyOf": [{ "enum": ["general", "local-research-only"] }, { "type": "null" }] },
          "admissionReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "splitGroupId": { "$ref": "#/$defs/id" },
          "split": { "anyOf": [{ "enum": ["train", "validation", "test"] }, { "type": "null" }] }
        }
      }
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "canonicalAssetId", "textureIds", "appearanceDisposition", "census"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "canonicalAssetId": { "$ref": "#/$defs/id" },
          "textureIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "appearanceDisposition": { "enum": ["exact-rgb", "material-only", "blocked"] },
          "census": { "enum": ["usable-texture-uv-v1"] }
        }
      }
    },
    "splitGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assetIds", "sourcePackIds", "textureIds", "admittedAssetIds", "split"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "assetIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "sourcePackIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "textureIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "admittedAssetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "split": { "anyOf": [{ "enum": ["train", "validation", "test"] }, { "type": "null" }] }
        }
      }
    },
    "contentSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]*$" },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePackId", "sourceId", "creator", "license", "sourceUrl", "assetEvidenceToken", "disposition", "admissionScope", "evidenceIds"],
      "properties": {
        "sourcePackId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "creator": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "minLength": 1 },
        "assetEvidenceToken": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "disposition": { "enum": ["verified", "attribution-only", "unverified", "blocked"] },
        "admissionScope": { "anyOf": [{ "enum": ["general", "local-research-only"] }, { "type": "null" }] },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["repository-file", "remote-content", "policy-snapshot"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "assertion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
