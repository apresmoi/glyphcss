{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": "../..",
    "paths": {
      "@glyphcss/core": ["packages/core/src/index.ts"],
      "@glyphcss/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["**/*.ts", "../../packages/core/src/parser/pngjs-browser.d.ts"]
}
