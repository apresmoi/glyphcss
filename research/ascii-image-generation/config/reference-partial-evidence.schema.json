{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyph-reprojection-reference-partial-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "fullG5Pass", "contract", "measurementContract", "hardware", "provenance", "signals", "latencyGate", "decomposition", "priorRedEvidence", "traceSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-reprojection-reference-partial-evidence/v1" },
    "status": { "const": "partial-non-pass" },
    "fullG5Pass": { "const": false },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "inputSha256", "frameSha256", "eventSha256", "resultChainSha256"],
      "properties": {
        "path": { "const": "fixtures/reprojection/reference-trace-v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "inputSha256": { "$ref": "#/$defs/sha256" },
        "frameSha256": { "$ref": "#/$defs/sha256" },
        "eventSha256": { "$ref": "#/$defs/sha256" },
        "resultChainSha256": { "const": "a804bbdb657fb2d66b263c7681ef2ade4688674070d3c491d9ba2fd2b6ff6297" }
      }
    },
    "measurementContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256", "g5SignatureSha256"],
      "properties": {
        "path": { "const": "config/measurement-gates.json" },
        "version": { "const": "v3" },
        "sha256": { "const": "122b3a42d75f9e9a0b473c9c2c38814cce3dc4239d27bb935af183c7e9fd43e9" },
        "g5SignatureSha256": { "const": "0fee24a6ca7019f5a92974476e606b89eb990695b240a1cdfbab437d92e8885e" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "gpu", "runtime"],
      "properties": {
        "browser": { "const": "Chromium 140.0.7339.80" },
        "gpu": { "const": "LeDeluge NVIDIA GeForce RTX 4090 Laptop GPU (16 GB)" },
        "runtime": { "const": "Browser WebGPU only; CPU fallback disabled" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "environmentManifestPath", "environmentManifestSha256", "imageId", "sourceArchiveSha256", "sourceFileSetSha256", "packageSha256", "lockfileSha256", "hostOs", "containerOsReleaseSha256", "driver", "gpuUuid"],
      "properties": {
        "runId": { "type": "string", "pattern": "^(?=.{2,80}$)[a-z0-9][a-z0-9._-]*[a-z0-9]$" },
        "environmentManifestPath": { "type": "string", "minLength": 1 },
        "environmentManifestSha256": { "$ref": "#/$defs/sha256" },
        "imageId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sourceArchiveSha256": { "$ref": "#/$defs/sha256" },
        "sourceFileSetSha256": { "$ref": "#/$defs/sha256" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "hostOs": { "type": "string", "minLength": 1 },
        "containerOsReleaseSha256": { "$ref": "#/$defs/sha256" },
        "driver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "gpuUuid": { "type": "string", "pattern": "^GPU-[A-Fa-f0-9-]+$" }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation-p95", "coverage", "valid-pixel-error", "newly-revealed-area", "disocclusion-recovery-latency", "temporal-warp-error", "correction-magnitude", "reset-frequency", "stale-result-rejection"],
      "properties": {
        "presentation-p95": { "$ref": "#/$defs/numericSignal" },
        "coverage": { "$ref": "#/$defs/numericSignal" },
        "valid-pixel-error": { "$ref": "#/$defs/numericSignal" },
        "newly-revealed-area": { "$ref": "#/$defs/numericSignal" },
        "temporal-warp-error": { "$ref": "#/$defs/numericSignal" },
        "reset-frequency": { "$ref": "#/$defs/numericSignal" },
        "disocclusion-recovery-latency": { "$ref": "#/$defs/unavailableSignal" },
        "correction-magnitude": { "$ref": "#/$defs/unavailableSignal" },
        "stale-result-rejection": { "$ref": "#/$defs/unavailableSignal" }
      }
    },
    "latencyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold", "actual", "pass"],
      "properties": {
        "metric": { "const": "presentation-p95" },
        "operator": { "const": "<=" },
        "threshold": { "const": 33.3 },
        "actual": { "type": "number" },
        "pass": { "type": "boolean" }
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundedTransitions", "timestampQuery", "cpu", "gpu", "cdpCorrelatedTransitions"],
      "properties": {
        "boundedTransitions": { "const": 8 },
        "timestampQuery": { "type": "boolean" },
        "cdpCorrelatedTransitions": { "const": 8 },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routingMeanMs", "uploadEnqueueMeanMs", "dispatchEncodingMeanMs", "renderEncodingMeanMs", "canvasSubmitMeanMs", "gpuCompletionMeanMs", "compositorPresentationMeanMs"],
          "properties": {
            "routingMeanMs": { "$ref": "#/$defs/nonnegative" },
            "uploadEnqueueMeanMs": { "$ref": "#/$defs/nonnegative" },
            "dispatchEncodingMeanMs": { "$ref": "#/$defs/nonnegative" },
            "renderEncodingMeanMs": { "$ref": "#/$defs/nonnegative" },
            "canvasSubmitMeanMs": { "$ref": "#/$defs/nonnegative" },
            "gpuCompletionMeanMs": { "$ref": "#/$defs/nonnegative" },
            "compositorPresentationMeanMs": { "$ref": "#/$defs/nonnegative" }
          }
        },
        "gpu": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["computeMeanNs", "renderMeanNs", "totalMeanNs"],
              "properties": {
                "computeMeanNs": { "$ref": "#/$defs/nonnegative" },
                "renderMeanNs": { "$ref": "#/$defs/nonnegative" },
                "totalMeanNs": { "$ref": "#/$defs/nonnegative" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["computeMeanNs", "renderMeanNs", "totalMeanNs", "unavailableReason"],
              "properties": {
                "computeMeanNs": { "type": "null" },
                "renderMeanNs": { "type": "null" },
                "totalMeanNs": { "type": "null" },
                "unavailableReason": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "priorRedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "traceSha256", "normalizedSummarySha256", "referenceImageSha256", "runManifestSha256", "coverage", "newlyRevealedArea"],
      "properties": {
        "preserved": { "const": true },
        "traceSha256": { "const": "4b9d7ef97a9d765067aa019f598e147117507c3e0e9530ac44ce206f89d35c7d" },
        "normalizedSummarySha256": { "const": "25a6b35665a89ef4999eb1259e40ab05c8a972164e0c4f5966d043d901a19e70" },
        "referenceImageSha256": { "const": "3a034dd9275e3451e190e0df50da9891e8fee611c5092aa0034a1de9d206148f" },
        "runManifestSha256": { "const": "7ae59aad465be911e46f0f5d2ef9514b24982439efaa25cf2d915dc88125ae25" },
        "coverage": { "const": 0.5 },
        "newlyRevealedArea": { "const": 0.5 }
      }
    },
    "traceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonnegative": { "type": "number", "minimum": 0 },
    "numericSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": { "type": "number" } }
    },
    "unavailableSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": { "value": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } }
    }
  }
}
