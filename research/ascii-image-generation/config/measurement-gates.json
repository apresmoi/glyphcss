      "statusRule": "all-wired-metrics-pass; unwired-is-not-pass",
      "metrics": [
        {
          "id": "visible-bytes",
          "formula": "byteMismatchCount",
          "unit": "bytes",
          "population": "golden raster fixtures",
          "aggregation": "max",
          "direction": "eq",
          "threshold": 0,
          "scope": "runtime default visible",
          "evidence": "reports/evidence/raw/g0.json",
          "unwired": false
        },
        {
          "id": "selector-parity",
          "formula": "max byte mismatch across runtime/static/compiler × visible/semantic",
          "unit": "bytes",
          "population": "golden selector fixtures",
          "aggregation": "max",
          "direction": "eq",
          "threshold": 0,
          "scope": "runtime/static/compiler",
          "evidence": "reports/evidence/raw/g0.json",
          "unwired": false
        },
        {
          "id": "winner-lineage",
          "formula": "incorrect winner→polygon→surface→instance→class→dictionary links",
          "unit": "cells",
          "population": "covered semantic/control cells",
          "aggregation": "sum",
          "direction": "eq",
          "threshold": 0,
          "scope": "winner metadata",
          "evidence": "reports/evidence/raw/g0.json",
          "unwired": false
        },
        {
          "id": "default-winner-allocation",
          "formula": "winner buffer allocations while capture disabled",
