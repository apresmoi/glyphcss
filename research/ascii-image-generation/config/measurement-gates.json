          "formula": "projection passes per output render",
          "unit": "passes",
          "population": "selector fixtures",
          "aggregation": "max",
          "direction": "eq",
          "threshold": 1,
          "scope": "all selectors",
          "evidence": "reports/evidence/raw/g0.json",
          "unwired": false
        },
        {
          "id": "pre-writes",
          "formula": "textContent writes per pre per render",
          "unit": "writes",
          "population": "base and detail pre fixtures",
          "aggregation": "max",
          "direction": "eq",
          "threshold": 1,
