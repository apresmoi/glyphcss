{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://glyphcss.dev/schema/ascii-image-generation/pilot-balance/v2", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "admittedOnly", "targetKind", "splits", "contentSha256"],
  "properties": { "schemaVersion": { "const": "glyph-pilot-balance/v2" }, "status": { "const": "complete" }, "admittedOnly": { "const": true }, "targetKind": { "const": "native-exact-rgb/v1" }, "splits": { "type": "object", "additionalProperties": false, "required": ["train", "validation", "test"], "properties": { "train": { "$ref": "#/$defs/stats" }, "validation": { "$ref": "#/$defs/stats" }, "test": { "$ref": "#/$defs/stats" } } }, "contentSha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "map": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }, "stats": { "type": "object", "additionalProperties": false, "required": ["frames", "sourcePacks", "classes", "semanticGlyphs", "instances", "surfaces", "cameras", "motions", "occlusions", "lighting", "geometry", "textures", "textureStatus", "appearance", "scenes", "trajectories", "splitGroups"], "properties": { "frames": { "type": "integer", "minimum": 1 }, "sourcePacks": { "$ref": "#/$defs/map" }, "classes": { "$ref": "#/$defs/map" }, "semanticGlyphs": { "$ref": "#/$defs/map" }, "instances": { "$ref": "#/$defs/map" }, "surfaces": { "$ref": "#/$defs/map" }, "cameras": { "$ref": "#/$defs/map" }, "motions": { "$ref": "#/$defs/map" }, "occlusions": { "$ref": "#/$defs/map" }, "lighting": { "$ref": "#/$defs/map" }, "geometry": { "$ref": "#/$defs/map" }, "textures": { "$ref": "#/$defs/map" }, "textureStatus": { "$ref": "#/$defs/map" }, "appearance": { "$ref": "#/$defs/map" }, "scenes": { "$ref": "#/$defs/map" }, "trajectories": { "$ref": "#/$defs/map" }, "splitGroups": { "$ref": "#/$defs/map" } } } }
}
