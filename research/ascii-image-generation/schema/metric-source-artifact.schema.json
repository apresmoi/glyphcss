{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/metric-source-artifact/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactVersion",
    "gate",
    "hardware",
    "signals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "metric-source-artifact/v1"
    },
    "artifactVersion": {
      "const": "v1"
    },
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ]
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "signals": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/signal"
      }
    },
    "fixture": {
      "type": "string"
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    }
  },
  "$defs": {
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "gpu",
        "runtime"
      ],
      "properties": {
        "browser": {
          "const": "Chromium 140.0.7339.80"
        },
        "gpu": {
          "const": "LeDeluge NVIDIA GeForce RTX 4090 Laptop GPU (16 GB)"
        },
        "runtime": {
          "const": "Browser WebGPU only; CPU fallback disabled"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "metric"],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "reports/eval-baseline.json" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "inputs", "result"],
          "properties": {
            "id": { "const": "admission" },
            "inputs": {
              "type": "object",
              "additionalProperties": { "type": "number" },
              "minProperties": 1
            },
            "result": {
              "type": "object",
              "required": ["value"],
              "properties": { "value": { "enum": [0, 1] } },
              "additionalProperties": { "type": ["boolean", "number"] }
            }
          }
        }
      }
    },
    "signal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
