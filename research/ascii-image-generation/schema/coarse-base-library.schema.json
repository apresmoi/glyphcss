{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/coarse-base-library-v1.json",
  "title": "Glyphcss coarse base library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "disposition", "contentSha256", "selection", "controlContract", "source", "bases"],
  "properties": {
    "schemaVersion": { "const": "glyph-coarse-base-library/v1" },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "disposition": { "const": "coarse-vertical-slice-only" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumConfidence", "cameraNeighborhood"],
      "properties": {
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cameraNeighborhood": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRotXDelta", "maxRotYDelta", "maxZoomRelativeDelta"],
          "properties": {
            "maxRotXDelta": { "type": "number", "exclusiveMinimum": 0 },
            "maxRotYDelta": { "type": "number", "exclusiveMinimum": 0 },
            "maxZoomRelativeDelta": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "controlContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256", "grid", "channels"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cols", "rows"],
          "properties": {
            "cols": { "type": "integer", "minimum": 1 },
            "rows": { "type": "integer", "minimum": 1 }
          }
        },
        "channels": { "const": 17 }
      }
    },
    "source": { "type": "object" },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "image", "prompt", "styleIds", "camera", "controls", "provenance"],
        "properties": {
          "id": { "type": "string", "pattern": "^base/" },
          "label": { "type": "string", "minLength": 1 },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mimeType", "width", "height", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "mimeType": { "const": "image/png" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "tags"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "styleIds": { "type": "array", "minItems": 1, "items": { "enum": ["base", "style A", "style B"] } },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projection", "rotX", "rotY", "zoom"],
            "properties": {
              "projection": { "const": "orthographic" },
              "rotX": { "type": "number" },
              "rotY": { "type": "number" },
              "zoom": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "controls": {
            "type": "object",
            "additionalProperties": false,
            "required": ["geometry", "sceneId"],
            "properties": {
              "geometry": { "enum": ["cube", "sphere", "prism"] },
              "sceneId": { "type": "string", "minLength": 1 }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "assetId", "licenseAuthority"],
            "properties": {
              "kind": { "const": "registry-admitted-exact-rgb-render" },
              "assetId": { "type": "string", "pattern": "^asset/[a-f0-9]{64}$" },
              "licenseAuthority": { "const": "reports/asset-registry.json" }
            }
          }
        }
      }
    }
  }
}
