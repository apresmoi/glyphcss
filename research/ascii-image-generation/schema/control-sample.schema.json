{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://glyphcss.dev/schema/ascii-image-generation/control-sample/v2", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "sceneId", "sceneSha256", "sceneSeed", "split", "dictionaryId", "dictionarySha256", "camera", "prompt", "geometryTags", "ascii", "controls", "style", "targetProvenance", "artifacts", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "control-sample/v2" }, "id": { "$ref": "#/$defs/id" }, "sceneId": { "$ref": "#/$defs/id" }, "sceneSha256": { "$ref": "#/$defs/hash" }, "sceneSeed": { "type": "string", "minLength": 1 }, "split": { "enum": ["train", "validation", "test"] }, "dictionaryId": { "$ref": "#/$defs/id" }, "dictionarySha256": { "$ref": "#/$defs/hash" }, "prompt": { "type": "string", "minLength": 1 }, "geometryTags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "ascii": { "$ref": "#/$defs/ascii" }, "camera": { "$ref": "#/$defs/camera" }, "controls": { "$ref": "#/$defs/controls" }, "style": { "$ref": "#/$defs/style" }, "targetProvenance": { "$ref": "#/$defs/provenance" }, "artifacts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/artifact" } }, "contentSha256": { "$ref": "#/$defs/hash" },
    "transition": { "type": "object", "additionalProperties": false, "required": ["sourceFrameId", "targetFrameId", "reprojectionMatrix", "atlasUpdate"], "properties": { "sourceFrameId": { "$ref": "#/$defs/id" }, "targetFrameId": { "$ref": "#/$defs/id" }, "reprojectionMatrix": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "number" } }, "atlasUpdate": { "type": "object", "additionalProperties": false, "required": ["surfaceIds", "confidenceMapSha256"], "properties": { "surfaceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "confidenceMapSha256": { "$ref": "#/$defs/hash" } } } } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]*$" }, "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "ascii": { "type": "object", "additionalProperties": false, "required": ["width", "height", "visibleCells", "semanticCells", "outputSource"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "visibleCells": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "semanticCells": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "outputSource": { "enum": ["glyphcss-control-frame/v1"] } } },
    "grid": { "type": "object", "additionalProperties": false, "required": ["width", "height", "values"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "values": { "type": "array", "minItems": 1 } } }, "numericGrid": { "allOf": [{ "$ref": "#/$defs/grid" }, { "type": "object", "properties": { "values": { "items": { "type": "number" } } } }] }, "unitGrid": { "allOf": [{ "$ref": "#/$defs/grid" }, { "type": "object", "properties": { "values": { "items": { "type": "number", "minimum": 0, "maximum": 1 } } } }] }, "binaryGrid": { "allOf": [{ "$ref": "#/$defs/grid" }, { "type": "object", "properties": { "values": { "items": { "enum": [0, 1] } } } }] },
    "controls": { "type": "object", "additionalProperties": false, "required": ["winnerPolygon", "semanticClassId", "objectInstanceId", "surfaceId", "depth", "normal", "worldPosition", "surfaceUv", "coverage", "shade", "validity", "disocclusion", "confidence"], "properties": { "winnerPolygon": { "$ref": "#/$defs/numericGrid" }, "semanticClassId": { "$ref": "#/$defs/numericGrid" }, "objectInstanceId": { "$ref": "#/$defs/stringGrid" }, "surfaceId": { "$ref": "#/$defs/stringGrid" }, "depth": { "$ref": "#/$defs/numericGrid" }, "normal": { "$ref": "#/$defs/numericGrid" }, "worldPosition": { "$ref": "#/$defs/numericGrid" }, "surfaceUv": { "$ref": "#/$defs/numericGrid" }, "coverage": { "$ref": "#/$defs/unitGrid" }, "shade": { "$ref": "#/$defs/unitGrid" }, "validity": { "$ref": "#/$defs/binaryGrid" }, "disocclusion": { "$ref": "#/$defs/binaryGrid" }, "confidence": { "$ref": "#/$defs/unitGrid" } } }, "stringGrid": { "allOf": [{ "$ref": "#/$defs/grid" }, { "type": "object", "properties": { "values": { "items": { "type": "string" } } } }] },
    "camera": { "type": "object", "additionalProperties": false, "required": ["id", "projection", "rotX", "rotY", "zoom", "target", "viewport", "grid", "fontSize", "lineHeight", "supersample", "renderMode"], "properties": { "id": { "$ref": "#/$defs/id" }, "projection": { "enum": ["orthographic", "perspective"] }, "rotX": { "type": "number" }, "rotY": { "type": "number" }, "zoom": { "type": "number", "exclusiveMinimum": 0 }, "target": { "$ref": "#/$defs/vec3" }, "perspective": { "type": "number", "minimum": 0 }, "distance": { "type": "number", "minimum": 0 }, "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "grid": { "type": "object", "additionalProperties": false, "required": ["cols", "rows"], "properties": { "cols": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } }, "fontSize": { "type": "number", "exclusiveMinimum": 0 }, "lineHeight": { "type": "number", "exclusiveMinimum": 0 }, "supersample": { "type": "integer", "minimum": 1 }, "renderMode": { "enum": ["solid"] } } },
    "style": { "type": "object", "additionalProperties": false, "required": ["id", "version", "strength", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "strength": { "type": "number", "minimum": 0, "maximum": 1 }, "sha256": { "$ref": "#/$defs/hash" } } }, "provenance": { "type": "object", "additionalProperties": false, "required": ["provider", "model", "version", "generationSeed", "license", "sourceRevision", "requestSha256"], "properties": { "provider": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "generationSeed": { "type": "string", "minLength": 1 }, "license": { "type": "string", "minLength": 1 }, "sourceRevision": { "type": "string", "minLength": 1 }, "requestSha256": { "$ref": "#/$defs/hash" } } }, "artifact": { "type": "object", "additionalProperties": false, "required": ["role", "outputSource", "path", "sha256"], "properties": { "role": { "enum": ["control-bundle", "target"] }, "outputSource": { "enum": ["visible", "semantic", "target"] }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } } }
  }
}
