{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/coarse-teacher-latent-v1.json",
  "title": "Glyphcss resumable teacher latent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "contentSha256", "backend", "authority", "anchor", "branches"],
  "properties": {
    "schemaVersion": { "const": "glyph-teacher-latent/v1" },
    "id": { "type": "string", "pattern": "^teacher-run/" },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "backend": {
      "type": "object",
      "required": ["kind", "claim"],
      "properties": {
        "kind": { "enum": ["native-diffusion-intermediate", "deterministic-coarse-teacher-surrogate"] },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "required": ["model", "vae", "scheduler", "timestep", "scaling", "prompt", "control", "noise"],
      "properties": {
        "model": { "type": "object" },
        "vae": { "type": "object" },
        "scheduler": { "type": "object" },
        "timestep": { "type": "object" },
        "scaling": { "type": "object" },
        "prompt": { "type": "object" },
        "control": { "type": "object" },
        "noise": { "type": "object" }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["latent", "resume"],
      "properties": {
        "latent": { "type": "object" },
        "resume": { "type": "object" }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "seed", "latent", "decodedPreview", "trajectory"],
        "properties": {
          "id": { "type": "string" },
          "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "latent": { "type": "object" },
          "decodedPreview": { "type": "object" },
          "trajectory": { "type": "object" }
        }
      }
    }
  }
}
