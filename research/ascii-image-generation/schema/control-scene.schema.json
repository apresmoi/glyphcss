{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://glyphcss.dev/schema/ascii-image-generation/control-scene/v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "dictionaryId", "dictionarySha256", "geometrySha256", "polygonOrderSha256", "instances", "surfaces", "polygonSurfaceIds", "contentSha256"],
  "properties": { "schemaVersion": { "const": "control-scene/v1" }, "id": { "$ref": "#/$defs/id" }, "dictionaryId": { "$ref": "#/$defs/id" }, "dictionarySha256": { "$ref": "#/$defs/hash" }, "geometrySha256": { "$ref": "#/$defs/hash" }, "polygonOrderSha256": { "$ref": "#/$defs/hash" }, "contentSha256": { "$ref": "#/$defs/hash" }, "instances": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "classId"], "properties": { "id": { "$ref": "#/$defs/id" }, "classId": { "type": "integer", "minimum": 1 } } } }, "surfaces": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "instanceId"], "properties": { "id": { "$ref": "#/$defs/id" }, "instanceId": { "$ref": "#/$defs/id" } } } }, "polygonSurfaceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]*$" } }
}
