{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/pilot-target-admission/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "targetContentSha256", "targetImageSha256", "b10"],
  "properties": {
    "schemaVersion": { "const": "glyph-pilot-target-admission/v1" },
    "targetId": { "type": "string", "minLength": 1 },
    "targetContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetImageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "b10": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator", "contractVersion", "contractSha256", "baselineSha256", "accepted", "metrics"],
      "properties": {
        "evaluator": { "const": "admission-v1" }, "contractVersion": { "const": "v3" },
        "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baselineSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "accepted": { "const": true },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["visible-ascii-adherence", "semantic-class-presence", "dictionary-class-confusion", "instance-surface-preservation", "depth-edge-agreement", "unintended-additions", "style-match", "cross-view-identity", "reprojection-valid-error", "disocclusion-recovery", "temporal-warp-error", "correction-magnitude"],
          "properties": {
            "visible-ascii-adherence": { "type": "number", "minimum": 0 }, "semantic-class-presence": { "type": "number", "minimum": 0 }, "dictionary-class-confusion": { "type": "number", "minimum": 0 }, "instance-surface-preservation": { "type": "number", "minimum": 0 }, "depth-edge-agreement": { "type": "number", "minimum": 0 }, "unintended-additions": { "type": "number", "minimum": 0 }, "style-match": { "type": "number", "minimum": 0 }, "cross-view-identity": { "type": "number", "minimum": 0 }, "reprojection-valid-error": { "type": "number", "minimum": 0 }, "disocclusion-recovery": { "type": "number", "minimum": 0 }, "temporal-warp-error": { "type": "number", "minimum": 0 }, "correction-magnitude": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
