{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/asset-semantic-parity-run/v1",
  "title": "Sealed B50 Node-browser semantic control parity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "verdict", "command", "authorities", "sourceArchive", "image", "runtime", "testOutput", "cases", "overallVerdict", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-asset-semantic-parity-run/v1" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,80}$" },
    "verdict": { "enum": ["pass", "fail"] },
    "overallVerdict": { "enum": ["pass", "fail"] },
    "command": { "const": "pnpm --dir research/ascii-image-generation exec playwright test --config playwright.config.ts browser/asset-semantic-parity.spec.ts --workers=1" },
    "authorities": {
      "type": "object", "additionalProperties": false,
      "required": ["registrySha256", "dictionary", "mapping"],
      "properties": {
        "registrySha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" },
        "dictionary": { "type": "object", "additionalProperties": false, "required": ["id", "contentSha256"], "properties": { "id": { "type": "string" }, "contentSha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" } } },
        "mapping": { "type": "object", "additionalProperties": false, "required": ["id", "contentSha256"], "properties": { "id": { "type": "string" }, "contentSha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" } } }
      }
    },
    "sourceArchive": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "const": "source-tree.tar" }, "sha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" } } },
    "image": { "type": "object", "additionalProperties": false, "required": ["digest"], "properties": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["node", "pnpm", "playwright", "chromium"], "properties": { "node": { "type": "string", "minLength": 2 }, "pnpm": { "type": "string", "minLength": 1 }, "playwright": { "type": "string", "minLength": 1 }, "chromium": { "type": "string", "minLength": 1 } } },
    "testOutput": { "type": "object", "additionalProperties": false, "required": ["exitCode", "sha256"], "properties": { "exitCode": { "type": "integer" }, "sha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" } } },
    "cases": { "type": "array", "minItems": 11, "items": { "type": "object", "additionalProperties": false, "required": ["assetId", "canonicalPath", "classId", "semanticGlyph", "controlColor", "nodeFrameSha256", "browserFrameSha256", "controlIdentitySha256", "verdict"], "properties": { "assetId": { "type": "string", "pattern": "^asset/[a-f0-9]{64}$" }, "canonicalPath": { "type": "string", "pattern": "^website/public/gallery/.+\\.glb$" }, "classId": { "type": "integer", "minimum": 1 }, "semanticGlyph": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/printableGlyph" }, "controlColor": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }, "nodeFrameSha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" }, "browserFrameSha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" }, "controlIdentitySha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" }, "verdict": { "enum": ["pass", "fail"] } } } },
    "contentSha256": { "$ref": "https://glyphcss.dev/schema/ascii-image-generation/glyph-object-dictionary/v2#/$defs/sha256" }
  }
}
