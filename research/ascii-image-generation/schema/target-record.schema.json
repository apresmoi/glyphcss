{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/target-record/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "imageSha256", "imagePath", "provider", "providerRequest", "requestSha256", "request", "lineage", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-image-target/v2" },
    "targetId": { "$ref": "#/$defs/id" },
    "imageSha256": { "$ref": "#/$defs/hash" },
    "imagePath": { "$ref": "#/$defs/path" },
    "provider": { "$ref": "#/$defs/provider" },
    "providerRequest": { "$ref": "#/$defs/providerRequest" },
    "requestSha256": { "$ref": "#/$defs/hash" },
    "request": { "$ref": "#/$defs/request" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "modelRaster": { "$ref": "#/$defs/modelRaster" },
    "contentSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]*$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$" },
    "modelRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "source", "fit", "targetSampling", "discreteControlSampling", "continuousControlSampling", "latentContinuousSampling"],
      "properties": {
        "id": { "const": "glyph-model-raster/physical-cell-letterbox-v1" },
        "width": { "type": "integer", "const": 256 },
        "height": { "type": "integer", "const": 256 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cols", "rows", "cellAspect"],
          "properties": {
            "cols": { "type": "integer", "const": 256 },
            "rows": { "type": "integer", "const": 128 },
            "cellAspect": { "type": "number", "const": 2 }
          }
        },
        "fit": { "const": "contain" },
        "targetSampling": { "const": "nearest" },
        "discreteControlSampling": { "const": "nearest" },
        "continuousControlSampling": { "const": "nearest" },
        "latentContinuousSampling": { "const": "bilinear" }
      }
    },
    "frame": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["frameId", "index", "controlSha256"],
      "properties": {
        "frameId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "index": { "type": "integer", "minimum": 0 },
        "controlSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusId", "corpusSha256", "trajectoryId", "trajectorySha256", "controlTrajectorySha256", "sceneId", "sceneSha256", "dictionaryId", "dictionarySha256"],
      "properties": {
        "corpusId": { "$ref": "#/$defs/id" },
        "corpusSha256": { "$ref": "#/$defs/hash" },
        "trajectoryId": { "$ref": "#/$defs/id" },
        "trajectorySha256": { "$ref": "#/$defs/hash" },
        "controlTrajectorySha256": { "$ref": "#/$defs/hash" },
        "sceneId": { "$ref": "#/$defs/id" },
        "sceneSha256": { "$ref": "#/$defs/hash" },
        "dictionaryId": { "$ref": "#/$defs/id" },
        "dictionarySha256": { "$ref": "#/$defs/hash" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestSha256", "treeSha256", "glyphOutput"],
      "properties": {
        "manifestSha256": { "$ref": "#/$defs/hash" },
        "treeSha256": { "$ref": "#/$defs/hash" },
        "glyphOutput": { "enum": ["visible", "semantic"] }
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "semantic"],
      "properties": { "visible": { "$ref": "#/$defs/bundle" }, "semantic": { "$ref": "#/$defs/bundle" } }
    },
    "providerReference": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["fileId"], "properties": { "fileId": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["imageUrl"], "properties": { "imageUrl": { "type": "string", "pattern": "^https://" } } }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "bundle", "sourcePath", "sourceSha256", "pngPath", "pngSha256", "width", "height", "legend", "providerReference"],
      "properties": {
        "role": { "enum": ["visible-ascii", "semantic-ascii", "semantic-color", "depth", "normal", "world-position", "surface-uv", "coverage", "shade"] },
        "bundle": { "enum": ["visible", "semantic"] },
        "sourcePath": { "$ref": "#/$defs/path" },
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "pngPath": { "$ref": "#/$defs/path" },
        "pngSha256": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "legend": { "type": "object" },
        "providerReference": { "$ref": "#/$defs/providerReference" }
      }
    },
    "prior": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["targetId", "contentSha256", "imageSha256", "sequenceId", "frameId", "providerReference"],
      "properties": {
        "targetId": { "$ref": "#/$defs/id" },
        "contentSha256": { "$ref": "#/$defs/hash" },
        "imageSha256": { "$ref": "#/$defs/hash" },
        "sequenceId": { "$ref": "#/$defs/id" },
        "frameId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
        "providerReference": { "$ref": "#/$defs/providerReference" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "license", "sourceSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "sourceSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "trajectory", "bundles", "current", "next", "controls", "priorAcceptedTarget", "style", "candidates", "output", "requestSha256"],
      "properties": {
        "schemaVersion": { "const": "glyph-target-provider/v2" },
        "mode": { "enum": ["keyframe", "edit"] },
        "trajectory": { "$ref": "#/$defs/trajectory" },
        "bundles": { "$ref": "#/$defs/bundles" },
        "current": { "$ref": "#/$defs/frame" },
        "next": { "$ref": "#/$defs/frame" },
        "controls": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/control" } },
        "priorAcceptedTarget": { "$ref": "#/$defs/prior" },
        "style": { "$ref": "#/$defs/style" },
        "candidates": { "type": "integer", "minimum": 1, "maximum": 10 },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "quality", "format"],
          "properties": {
            "size": { "type": "string", "minLength": 1 },
            "quality": { "type": "string", "minLength": 1 },
            "format": { "enum": ["png", "jpeg", "webp"] }
          }
        },
        "requestSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "status"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["success", "transient", "failed"] },
        "status": { "type": ["integer", "null"], "minimum": 0 },
        "responseRequestId": { "type": "string", "minLength": 1 },
        "code": { "type": ["string", "null"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "apiVersion", "responseRequestId", "attempts", "reusedResponse"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "apiVersion": { "type": "string", "minLength": 1 },
        "responseRequestId": { "type": "string", "minLength": 1 },
        "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
        "reusedResponse": { "type": "boolean" }
      }
    },
    "providerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "operation", "endpoint", "method", "body", "prompt"],
      "properties": {
        "apiVersion": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "body": { "type": "object" },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectory", "bundles", "current", "next", "priorAcceptedTarget", "controls", "style", "candidateIndex"],
      "properties": {
        "trajectory": { "$ref": "#/$defs/trajectory" },
        "bundles": { "$ref": "#/$defs/bundles" },
        "current": { "$ref": "#/$defs/frame" },
        "next": { "$ref": "#/$defs/frame" },
        "priorAcceptedTarget": { "$ref": "#/$defs/prior" },
        "controls": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/control" } },
        "style": { "$ref": "#/$defs/style" },
        "candidateIndex": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
