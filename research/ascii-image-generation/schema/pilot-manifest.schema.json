{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/pilot-manifest/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "status", "datasetRoot", "authority", "balanceReport", "records", "materialOnly", "blockedAssets", "sourceCoverage", "heldOutAppearance", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-pilot-manifest/v2" }, "status": { "const": "complete" },
    "datasetRoot": { "const": "/mnt/docker-data/glyphcss-ascii-image-generation/datasets/pilot" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["kind", "admissionReport", "admissionReportSha256", "assetCorpusRoot"], "properties": { "kind": { "const": "B43-B45-native-asset-first/v1" }, "admissionReport": { "type": "string" }, "admissionReportSha256": { "$ref": "#/$defs/hash" }, "assetCorpusRoot": { "type": "string" } } },
    "balanceReport": { "$ref": "#/$defs/path" }, "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "materialOnly": { "type": "array", "items": { "$ref": "#/$defs/material" } }, "blockedAssets": { "type": "array", "items": { "$ref": "#/$defs/blocked" } }, "sourceCoverage": { "type": "array", "minItems": 77, "maxItems": 77, "items": { "$ref": "#/$defs/coverage" } }, "heldOutAppearance": { "type": "object", "additionalProperties": false, "required": ["validation", "test"], "properties": { "validation": { "$ref": "#/$defs/heldOut" }, "test": { "$ref": "#/$defs/heldOut" } } }, "contentSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$" },
    "record": { "type": "object", "additionalProperties": false, "required": ["targetId", "targetKind", "split", "trajectoryId", "frameIndex", "prompt", "sceneSha256", "trajectorySha256", "appearancePopulation", "asset", "variant", "frame", "target", "control", "modelRaster", "admission", "strata", "contentSha256"], "properties": { "targetId": { "type": "string" }, "targetKind": { "const": "native-exact-rgb/v1" }, "split": { "enum": ["train", "validation", "test"] }, "trajectoryId": { "type": "string", "minLength": 1 }, "frameIndex": { "type": "integer", "minimum": 0 }, "prompt": { "type": "string", "minLength": 1 }, "sceneSha256": { "$ref": "#/$defs/hash" }, "trajectorySha256": { "$ref": "#/$defs/hash" }, "appearancePopulation": { "type": "string", "minLength": 1 }, "asset": { "$ref": "#/$defs/asset" }, "variant": { "$ref": "#/$defs/variant" }, "frame": { "$ref": "#/$defs/frame" }, "target": { "$ref": "#/$defs/artifact" }, "control": { "$ref": "#/$defs/control" }, "modelRaster": { "$ref": "#/$defs/modelRaster" }, "admission": { "$ref": "#/$defs/admission" }, "strata": { "$ref": "#/$defs/strata" }, "contentSha256": { "$ref": "#/$defs/hash" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["id", "split", "splitGroupId", "classId", "sourceGeometrySha256", "textureIds", "sourcePackIds"], "properties": { "id": { "type": "string" }, "split": { "enum": ["train", "validation", "test"] }, "splitGroupId": { "type": "string" }, "classId": { "type": "integer" }, "sourceGeometrySha256": { "$ref": "#/$defs/hash" }, "textureIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }, "sourcePackIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true } } },
    "variant": { "type": "object", "additionalProperties": false, "required": ["id", "pose", "occlusion"], "properties": { "id": { "type": "string" }, "pose": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["static", "animated"] } } }, "occlusion": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } } },
    "frame": { "type": "object", "additionalProperties": false, "required": ["id", "cameraId", "lightingId"], "properties": { "id": { "type": "string" }, "cameraId": { "type": "string" }, "lightingId": { "type": "string" } } },
    "control": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "frameId"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" }, "frameId": { "type": "string" } } },
    "modelRaster": { "type": "object", "additionalProperties": false, "required": ["id", "width", "height", "source", "fit", "targetSampling", "discreteControlSampling", "continuousControlSampling", "latentContinuousSampling"], "properties": { "id": { "const": "glyph-model-raster/physical-cell-letterbox-v1" }, "width": { "const": 256 }, "height": { "const": 256 }, "source": { "type": "object", "additionalProperties": false, "required": ["cols", "rows", "cellAspect"], "properties": { "cols": { "const": 256 }, "rows": { "const": 128 }, "cellAspect": { "const": 2 } } }, "fit": { "const": "contain" }, "targetSampling": { "const": "nearest" }, "discreteControlSampling": { "const": "nearest" }, "continuousControlSampling": { "const": "nearest" }, "latentContinuousSampling": { "const": "bilinear" } } },
    "admission": { "type": "object", "additionalProperties": false, "required": ["reportSha256", "recordSha256", "b10"], "properties": { "reportSha256": { "$ref": "#/$defs/hash" }, "recordSha256": { "$ref": "#/$defs/hash" }, "b10": { "type": "object", "required": ["evaluator", "contractVersion", "accepted", "metrics"], "properties": { "evaluator": { "const": "admission-v1" }, "contractVersion": { "const": "v3" }, "accepted": { "const": true }, "metrics": { "type": "object" } } } } },
    "strata": { "type": "object", "additionalProperties": false, "required": ["semanticGlyphs", "instances", "surfaces"], "properties": { "semanticGlyphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "instances": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "material": { "type": "object", "additionalProperties": false, "required": ["assetId", "split", "splitGroupId", "sourcePackIds", "sourceGeometrySha256", "textureIds", "targetStatus", "disposition", "sourceRecordSha256", "contentSha256"], "properties": { "assetId": { "type": "string" }, "split": { "enum": ["train", "validation", "test"] }, "splitGroupId": { "type": "string" }, "sourcePackIds": { "type": "array", "items": { "type": "string" } }, "sourceGeometrySha256": { "$ref": "#/$defs/hash" }, "textureIds": { "type": "array", "items": { "type": "string" } }, "targetStatus": { "const": "material-only-not-exact-rgb" }, "disposition": { "const": "excluded-from-exact-rgb-training" }, "sourceRecordSha256": { "$ref": "#/$defs/hash" }, "contentSha256": { "$ref": "#/$defs/hash" } } },
    "blocked": { "type": "object", "additionalProperties": false, "required": ["assetId", "appearanceDisposition", "reasons"], "properties": { "assetId": { "type": "string" }, "appearanceDisposition": { "type": "string" }, "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["path", "canonicalAssetId", "disposition", "reasons"], "properties": { "path": { "type": "string" }, "canonicalAssetId": { "type": "string" }, "disposition": { "enum": ["represented", "admission-failure"] }, "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "heldOut": { "type": "object", "additionalProperties": false, "required": ["assetIds", "appearancePopulations"], "properties": { "assetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "appearancePopulations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } }
  }
}
