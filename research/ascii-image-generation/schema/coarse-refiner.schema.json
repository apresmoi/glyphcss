{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/coarse-refiner-v1.json",
  "title": "Glyphcss coarse browser residual refiner",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "contentSha256", "disposition", "architecture", "inputs", "featureOrder", "weights", "bias", "output", "training"],
  "properties": {
    "schemaVersion": { "const": "glyph-browser-residual-refiner/v1" },
    "id": { "type": "string", "minLength": 1 },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "disposition": { "const": "runnable-native-trajectory-trained-reference" },
    "architecture": {
      "type": "object",
      "required": ["kind", "relationToDiffusion", "inputWidth", "outputWidth", "parameterCount", "operators"],
      "properties": {
        "kind": { "const": "explicit-per-pixel-residual-mlp" },
        "relationToDiffusion": { "const": "independent-artifact-not-unet-layers" },
        "inputWidth": { "const": 10 },
        "outputWidth": { "const": 3 },
        "parameterCount": { "const": 33 },
        "operators": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "inputs": { "type": "object" },
    "featureOrder": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "string" } },
    "weights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10,
        "items": { "type": "number" }
      }
    },
    "bias": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "output": { "type": "object" },
    "training": {
      "type": "object",
      "required": ["performed", "sourceBackend", "nativeManifestContentSha256", "nativeManifestFileSha256", "controlTensorSha256", "decodedPreviewSha256", "sampleCount", "solver", "ridge", "meanSquaredError", "command", "claim"],
      "properties": {
        "performed": { "const": true },
        "sourceBackend": { "const": "native-diffusion-intermediate" },
        "nativeManifestContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "nativeManifestFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "controlTensorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodedPreviewSha256": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "solver": { "type": "string", "minLength": 1 },
        "ridge": { "type": "number", "minimum": 0 },
        "meanSquaredError": { "type": "number", "minimum": 0 },
        "command": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    }
  }
}
