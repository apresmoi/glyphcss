{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/overfit-keyframe-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "acceptanceEligible", "synthetic", "authorities", "data", "runtime", "training", "checkpoint", "evaluation", "commands", "reportSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-overfit-keyframe-report/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail"] },
    "acceptanceEligible": { "const": true },
    "synthetic": { "const": false },
    "authorities": {
      "type": "object", "additionalProperties": false,
      "required": ["configSha256", "tensorContractSha256", "nativeReferenceModelSha256", "nativeReferencePreflightSha256", "measurementContractSha256", "causalityDerivationSha256", "containerDigest"],
      "properties": {
        "configSha256": { "$ref": "#/$defs/hash" },
        "tensorContractSha256": { "$ref": "#/$defs/hash" },
        "nativeReferenceModelSha256": { "$ref": "#/$defs/hash" },
        "nativeReferencePreflightSha256": { "$ref": "#/$defs/hash" },
        "measurementContractSha256": { "$ref": "#/$defs/hash" },
        "causalityDerivationSha256": { "$ref": "#/$defs/hash" },
        "containerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance", "manifestSha256", "balanceSha256", "selectionSha256", "frameCount", "population", "split", "targetKind", "trajectoryIds", "sceneSeeds", "motionKinds", "classIds", "semanticGlyphs", "rasterExpansion"],
      "properties": {
        "provenance": { "const": "native-asset-first-pilot/v1" },
        "manifestSha256": { "$ref": "#/$defs/hash" },
        "balanceSha256": { "$ref": "#/$defs/hash" },
        "selectionSha256": { "$ref": "#/$defs/hash" },
        "frameCount": { "type": "integer", "minimum": 1 },
        "population": { "const": "native-exact-rgb" },
        "split": { "const": "train" },
        "targetKind": { "const": "native-exact-rgb/v1" },
        "trajectoryIds": { "$ref": "#/$defs/nonemptyStrings" },
        "sceneSeeds": { "$ref": "#/$defs/nonemptyStrings" },
        "motionKinds": { "$ref": "#/$defs/nonemptyStrings" },
        "classIds": { "$ref": "#/$defs/nonemptyStrings" },
        "semanticGlyphs": { "$ref": "#/$defs/nonemptyStrings" }
        ,"rasterExpansion": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rasterExpansion" } }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["gpu", "totalVramMiB", "peakAllocatedMiB", "peakReservedMiB", "torch", "cuda"],
      "properties": {
        "gpu": { "type": "string", "minLength": 1 },
        "totalVramMiB": { "type": "number", "exclusiveMinimum": 0 },
        "peakAllocatedMiB": { "type": "number", "minimum": 0 },
        "peakReservedMiB": { "type": "number", "minimum": 0 },
        "torch": { "type": "string", "minLength": 1 },
        "cuda": { "type": "string", "minLength": 1 }
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "mixedPrecision", "gradientCheckpointing", "optimizer", "batchSize", "gradientAccumulationSteps", "maxSteps", "completedSteps", "completedMicrosteps", "seed", "losses"],
      "properties": {
        "architecture": { "const": "sdxl-depth-controlnet-17ch/v1" },
        "mixedPrecision": { "const": "fp16" },
        "gradientCheckpointing": { "const": true },
        "optimizer": { "const": "adamw8bit" },
        "batchSize": { "const": 1 },
        "gradientAccumulationSteps": { "type": "integer", "minimum": 1 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "completedSteps": { "type": "integer", "minimum": 1 },
        "completedMicrosteps": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "losses": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["modelPath", "modelSha256", "statePath", "stateSha256", "resumedFrom", "resumeIntegrity"],
      "properties": {
        "modelPath": { "$ref": "#/$defs/path" },
        "modelSha256": { "$ref": "#/$defs/hash" },
        "statePath": { "$ref": "#/$defs/path" },
        "stateSha256": { "$ref": "#/$defs/hash" },
        "resumedFrom": { "type": ["string", "null"] },
        "resumeIntegrity": { "const": true }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["formula", "thresholds", "correctSampleLosses", "correctSampleScores", "correctScore", "interventions", "allMarginsPass", "scoreRegion", "inverseProjection", "silhouette", "artifacts"],
      "properties": {
        "formula": { "const": "exp(-foreground_noise_prediction_mse)" },
        "thresholds": { "type": "object" },
        "correctSampleLosses": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
        "correctSampleScores": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "correctScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "interventions": {
          "type": "array", "minItems": 24, "maxItems": 24,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "score", "margin", "sampleLosses", "sampleScores", "sampleMargins", "samplePass", "pass"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "margin": { "type": "number" },
              "sampleLosses": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
              "sampleScores": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
              "sampleMargins": { "type": "array", "minItems": 1, "items": { "type": "number" } },
              "samplePass": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
              "pass": { "type": "boolean" }
            }
          }
        },
        "allMarginsPass": { "type": "boolean" }
        ,"scoreRegion": { "const": "coverage-foreground-only" }
        ,"inverseProjection": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "generatedPngRole", "final3dState", "samples"],
          "properties": {
            "mode": { "const": "exact-control-winner-lineage/no-remesh/v1" },
            "generatedPngRole": { "const": "diagnostic-one-view-rgb-not-final-3d-state" },
            "final3dState": { "const": false },
            "samples": { "type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["sampleId", "surfaceUvSha256", "worldPositionSha256", "winnerPolygonSha256", "coverageSha256"],
              "properties": {
                "sampleId": { "type": "string", "minLength": 1 },
                "surfaceUvSha256": { "$ref": "#/$defs/hash" },
                "worldPositionSha256": { "$ref": "#/$defs/hash" },
                "winnerPolygonSha256": { "$ref": "#/$defs/hash" },
                "coverageSha256": { "$ref": "#/$defs/hash" }
              }
            } }
          }
        }
        ,"silhouette": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sampleId", "coverageSha256", "score"], "properties": { "sampleId": { "type": "string", "minLength": 1 }, "coverageSha256": { "$ref": "#/$defs/hash" }, "score": { "const": 1 } } } }
        ,"artifacts": { "type": "object", "minProperties": 27, "additionalProperties": { "$ref": "#/$defs/evaluationArtifact" } }
      }
    },
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "resume", "verify"],
      "properties": {
        "run": { "type": "string", "minLength": 1 },
        "resume": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 }
      }
    },
    "reportSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$" },
    "nonemptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evaluationArtifact": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "width", "height"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" }, "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 } } }
    ,"rasterExpansion": { "type": "object", "additionalProperties": false, "required": ["id", "sourceWidth", "sourceHeight", "width", "height", "algorithm", "coverageChannel", "alphaAuthority", "backgroundCompositing", "sourceControlSha256", "outputControlSha256", "sourceTargetSha256", "outputTargetSha256", "coverageSha256"], "properties": {
      "id": { "const": "glyph-training-raster/admission-nearest-v1" }, "sourceWidth": { "const": 256 }, "sourceHeight": { "const": 256 },
      "width": { "const": 1024 }, "height": { "const": 1024 }, "algorithm": { "const": "nearest" },
      "coverageChannel": { "const": 15 }, "alphaAuthority": { "const": "coverage-only" },
      "backgroundCompositing": { "const": "downstream-optional-not-training-or-causal-eval" },
      "sourceControlSha256": { "$ref": "#/$defs/hash" }, "outputControlSha256": { "$ref": "#/$defs/hash" },
      "sourceTargetSha256": { "$ref": "#/$defs/hash" }, "outputTargetSha256": { "$ref": "#/$defs/hash" },
      "coverageSha256": { "$ref": "#/$defs/hash" }
    } }
  }
}
