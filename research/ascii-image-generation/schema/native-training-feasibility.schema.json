{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyphcss.dev/schema/ascii-image-generation/native-training-feasibility/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "verdict", "authorities", "training", "runtime", "measurement", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": "glyph-native-training-feasibility/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verdict": { "enum": ["pass", "fail"] },
    "authorities": {
      "type": "object", "additionalProperties": false,
      "required": ["configSha256", "nativeReferenceConfigSha256", "nativeReferencePreflightSha256", "nativeReferenceTreeSha256", "baseTreeSha256", "controlTreeSha256", "baseRevision", "controlRevision", "containerDigest"],
      "properties": {
        "configSha256": { "$ref": "#/$defs/hash" }, "nativeReferenceConfigSha256": { "$ref": "#/$defs/hash" },
        "nativeReferencePreflightSha256": { "$ref": "#/$defs/hash" }, "nativeReferenceTreeSha256": { "$ref": "#/$defs/hash" },
        "baseTreeSha256": { "$ref": "#/$defs/hash" }, "controlTreeSha256": { "$ref": "#/$defs/hash" },
        "baseRevision": { "$ref": "#/$defs/commit" }, "controlRevision": { "$ref": "#/$defs/commit" },
        "containerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["steps", "resolution", "batchSize", "gradientAccumulationSteps", "mixedPrecision", "gradientCheckpointing", "optimizer", "cpuOffload", "maximumPeakVramBytes", "seed"],
      "properties": {
        "steps": { "const": 1 }, "resolution": { "const": 256 }, "batchSize": { "const": 1 },
        "gradientAccumulationSteps": { "const": 1 }, "mixedPrecision": { "const": "fp16" },
        "gradientCheckpointing": { "const": true }, "optimizer": { "const": "adamw8bit" },
        "cpuOffload": { "type": "boolean" }, "maximumPeakVramBytes": { "const": 17179869184 },
        "seed": { "type": "integer" }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["gpu", "totalVramBytes", "python", "torch", "cuda", "diffusers", "bitsandbytes"],
      "properties": {
        "gpu": { "type": "string", "minLength": 1 }, "totalVramBytes": { "type": "integer", "minimum": 1 },
        "python": { "type": "string", "minLength": 1 }, "torch": { "type": "string", "minLength": 1 },
        "cuda": { "type": "string", "minLength": 1 }, "diffusers": { "type": "string", "minLength": 1 },
        "bitsandbytes": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["loss", "forwardSeconds", "backwardSeconds", "stepSeconds", "peakAllocatedBytes", "peakReservedBytes"],
      "properties": {
        "loss": { "type": "number", "minimum": 0 }, "forwardSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "backwardSeconds": { "type": "number", "exclusiveMinimum": 0 }, "stepSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "peakAllocatedBytes": { "type": "integer", "minimum": 1 }, "peakReservedBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "contentSha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
