FROM mcr.microsoft.com/playwright@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d

ARG NODE_VERSION=22.14.0
ARG NODE_SHA256=9d942932535988091034dc94cc5f42b6dc8784d6366df3a36c4c9ccb3996f0c2

USER root
RUN apt-get update \
  && apt-get install --no-install-recommends -y unzip=6.0-28ubuntu4.1 \
  && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --output /tmp/node.tar.gz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
  && echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum --check --strict \
  && tar --extract --gzip --file /tmp/node.tar.gz --directory /usr/local --strip-components=1 \
  && rm /tmp/node.tar.gz \
  && node --version | grep -Ex "v${NODE_VERSION}"
RUN npm install --global --force pnpm@10.32.1

ENV GLYPHCSS_REFERENCE_CHROMIUM_ARCHIVE=/artifacts/reference-browser/chrome-linux64-140.0.7339.80.zip
WORKDIR /workspace
COPY --chown=pwuser:pwuser package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=pwuser:pwuser packages/core ./packages/core
COPY --chown=pwuser:pwuser packages/glyphcss ./packages/glyphcss
COPY --chown=pwuser:pwuser packages/compile ./packages/compile
COPY --chown=pwuser:pwuser research/ascii-image-generation ./research/ascii-image-generation
RUN chown pwuser:users /workspace
USER pwuser
RUN pnpm install --filter @glyphcss/core... --filter glyphcss... --filter @glyphcss/compile... --filter @glyphcss/ascii-image-generation... --frozen-lockfile
RUN (cd packages/core && ./node_modules/.bin/tsup) \
  && (cd packages/glyphcss && ./node_modules/.bin/tsup) \
  && (cd packages/compile && ./node_modules/.bin/tsup --no-dts)
