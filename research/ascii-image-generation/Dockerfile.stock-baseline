ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/cache/huggingface \
    HF_HUB_DISABLE_XET=1
RUN python -m pip install --no-cache-dir \
    "diffusers==0.31.0" \
    "transformers==4.45.2" \
    "accelerate==1.0.1" \
    "huggingface-hub==0.26.2" \
