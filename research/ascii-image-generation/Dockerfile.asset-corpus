# syntax=docker/dockerfile:1.7
FROM node:22.14.0-bookworm-slim@sha256:745403dc46b5ab4c998502b07a12cbf020cf2c30645427a68ec0718f02d647de

ARG SOURCE_FILE_SET_SHA256
LABEL org.glyphcss.asset-corpus.base-image=node:22.14.0-bookworm-slim@sha256:745403dc46b5ab4c998502b07a12cbf020cf2c30645427a68ec0718f02d647de \
  org.glyphcss.asset-corpus.node-version=22.14.0 \
  org.glyphcss.asset-corpus.source-file-set-sha256=$SOURCE_FILE_SET_SHA256

WORKDIR /workspace
RUN corepack enable
RUN test "$(node --version)" = "v22.14.0" && test "$(command -v node)" = "/usr/local/bin/node"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core/package.json packages/core/package.json
COPY packages/glyphcss/package.json packages/glyphcss/package.json
COPY packages/compile/package.json packages/compile/package.json
COPY research/ascii-image-generation/package.json research/ascii-image-generation/package.json
RUN pnpm install --frozen-lockfile --filter @glyphcss/ascii-image-generation...
# BuildKit's bind mount keeps the host context out of image layers. Stage only
# the explicit source roots and exclude every host-generated dependency/output
# directory before the bytes enter /workspace.
RUN --mount=type=bind,target=/build-context,ro \
  tar -C /build-context \
    --exclude='*/node_modules' --exclude='*/dist' --exclude='*/.astro' \
    --exclude='*/__pycache__' --exclude='*/test-results' \
    --exclude='*/coverage' --exclude='*/playwright-report' \
    --exclude='*/.pytest_cache' --exclude='*/.vitest' \
    --exclude='research/ascii-image-generation/review' \
    --exclude='*.pyc' --exclude='*.pyo' --exclude='.DS_Store' \
    -cf - \
    package.json pnpm-lock.yaml pnpm-workspace.yaml \
    packages/core packages/glyphcss packages/compile \
    research/ascii-image-generation \
    website/public/gallery \
    website/src/components/GalleryWorkbench/presets \
  | tar -C /workspace -xf -
RUN node research/ascii-image-generation/scripts/verify-asset-corpus-image-source.mjs \
  --root /workspace \
  --expected "$SOURCE_FILE_SET_SHA256" \
  --write research/ascii-image-generation/reports/image-source-manifest.json
RUN pnpm --filter @glyphcss/core exec tsup
RUN pnpm --filter glyphcss exec tsup
RUN pnpm --filter @glyphcss/compile exec tsup

ENTRYPOINT ["node", "research/ascii-image-generation/src/render-asset-corpus.mjs"]
